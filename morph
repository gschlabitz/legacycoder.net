#!/usr/bin/env node
// Dispatcher for the morph scripts, avoiding npm-run's `--` ceremony:
//
//   ./morph task --issue 5
//   ./morph cmux --name experiments
//   ./morph attach --zed
//   ./morph warm / status / snapshots list
//   ./morph sleep / reap / sweep
//
// The npm scripts (npm run morph:task -- ...) keep working and run the same
// files; this is just the shorter front door.

const commands = {
  warm: "warm.mjs",
  task: "task.mjs",
  attach: "attach.mjs",
  cmux: "cmux.mjs",
  status: "status.mjs",
  snapshots: "snapshots.mjs",
  sleep: "sleep.mjs",
  reap: "reap.mjs",
  sweep: "sweep.mjs",
};

const [command, ...rest] = process.argv.slice(2);
const script = commands[command];
if (!script) {
  console.error(`Usage: ./morph <${Object.keys(commands).join("|")}> [args]`);
  process.exit(command ? 1 : 0);
}

// The scripts read process.argv.slice(2); shift our subcommand out of the way.
process.argv = [process.argv[0], `morph-${command}`, ...rest];
await import(new URL(`./scripts/morph/${script}`, import.meta.url));
