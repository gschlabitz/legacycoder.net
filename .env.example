# Google Maps JavaScript API key for the /bio journey-map banner.
# Client-side key by design — restrict it by HTTP referrer in the Google
# Cloud console. Copy this file to .env and fill it in; without it the map
# renders a placeholder in dev and nothing in production builds.
PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a cloud-styled map ID (Google Cloud console → Map Management) to
# own the map's look (e.g. hide POI labels). Defaults to Google's sandbox
# DEMO_MAP_ID, which advanced markers need at minimum.
PUBLIC_GOOGLE_MAPS_MAP_ID=
