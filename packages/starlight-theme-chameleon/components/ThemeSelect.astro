---
import DefaultThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'

import config from 'virtual:starlight-theme-chameleon/config'
import ThemeModeButton from './ThemeModeButton.astro'

const t = Astro.locals.t

// The skin selector's one localized string. When the key resolves nowhere —
// the site's default locale is outside the shipped set and the site added no
// translation — fall back to English rather than announcing the raw key.
const labelKey = 'starlightThemeChameleon.skinSelect.accessibleLabel'
const accessibleLabel = t.exists(labelKey) ? t(labelKey) : 'Select skin'

// Skin names are proper nouns and never translated (ADR 0004). That includes
// the first entry: the unskinned look is named after what it is — Starlight.
const options = [
  { label: 'Starlight', value: '' },
  ...config.skins.map((skin) => ({ label: skin.label, value: skin.name })),
]
---

{
  config.skinSelector !== 'hidden' && (
    <chameleon-skin-select data-variant={config.skinSelector}>
      <button
        class="skin-trigger"
        type="button"
        aria-label={accessibleLabel}
        aria-haspopup="listbox"
        aria-expanded="false"
        title={options[0].label}
      >
        <span class="sr-only">{accessibleLabel}</span>
        {config.skinSelector === 'select' && (
          <>
            <span class="selected-skin">{options[0].label}</span>
            <svg
              class="caret"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              width="16"
              height="16"
            >
              <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1 1 0 0 0 1.42 0L17 10.59a1 1 0 0 0 0-1.42Z" />
            </svg>
          </>
        )}
      </button>
      <div class="skin-menu" role="listbox" aria-label={accessibleLabel} hidden>
        {/* Visual heading; the listbox already announces the same label. */}
        <div class="skin-menu-heading" aria-hidden="true">{accessibleLabel}</div>
        {options.map(({ value, label }) => (
          <button
            class="skin-option"
            type="button"
            role="option"
            data-skin-value={value}
            aria-selected={value === '' ? 'true' : 'false'}
          >
            {/* data-skin scopes the skin's palette to the swatch alone; the
                rest of the option renders in the page's active skin. */}
            <span class="preview" data-skin={value || undefined}>
              <span class="preview-surface">
                <span class="preview-accent"></span>
                <span class="preview-line"></span>
                <span class="preview-line short"></span>
              </span>
            </span>
            <span class="skin-name" set:html={label} />
          </button>
        ))}
      </div>
    </chameleon-skin-select>
  )
}
{
  config.themeSelector === 'icon'
    ? <ThemeModeButton><slot /></ThemeModeButton>
    : <DefaultThemeSelect><slot /></DefaultThemeSelect>
}

{/* Inlined to avoid a flash of the wrong selector value on load. */}
<script is:inline>
	(() => {
		var stored = '';
		try {
			stored = localStorage.getItem('starlight-skin') || '';
		} catch (e) {}
		document.querySelectorAll('chameleon-skin-select [data-skin-value]').forEach((option) => {
			option.setAttribute('aria-selected', option.getAttribute('data-skin-value') === stored ? 'true' : 'false');
		});
		document.querySelectorAll('chameleon-skin-select').forEach((control) => {
			var selected = Array.from(control.querySelectorAll('[data-skin-value]')).find((option) => option.getAttribute('data-skin-value') === stored) || control.querySelector('[data-skin-value=""]');
			var label = selected && selected.querySelector('.skin-name');
			var text = label && label.textContent ? label.textContent.trim() : '';
			control.querySelectorAll('.selected-skin').forEach((node) => { node.textContent = text; });
			control.querySelectorAll('.skin-trigger').forEach((node) => {
				if (text) node.setAttribute('title', text);
			});
		});
	})();
</script>

<script>
	/** Key in `localStorage` to store the skin preference at. */
	const storageKey = 'starlight-skin'

	const loadSkin = (): string => {
		try {
			return localStorage.getItem(storageKey) || ''
		} catch {
			return ''
		}
	}

	const storeSkin = (skin: string): void => {
		try {
			if (skin) localStorage.setItem(storageKey, skin)
			else localStorage.removeItem(storageKey)
		} catch {
			/* Persistence is best-effort. */
		}
	}

	/** Flip the `data-skin` attribute and keep every selector instance in sync. */
	const applySkin = (skin: string): void => {
		if (skin) document.documentElement.dataset.skin = skin
		else delete document.documentElement.dataset.skin
		document.querySelectorAll<HTMLElement>('chameleon-skin-select').forEach((control) => {
			const selectedOption =
				Array.from(control.querySelectorAll<HTMLElement>('[data-skin-value]')).find(
					(option) => option.dataset.skinValue === skin
				) || control.querySelector<HTMLElement>('[data-skin-value=""]')
			control.querySelectorAll<HTMLElement>('[data-skin-value]').forEach((option) => {
				option.setAttribute('aria-selected', option.dataset.skinValue === skin ? 'true' : 'false')
			})
			const text = selectedOption?.querySelector('.skin-name')?.textContent?.trim() || ''
			const trigger = control.querySelector<HTMLButtonElement>('.skin-trigger')
			if (trigger && text) trigger.title = text
			control.querySelectorAll<HTMLElement>('.selected-skin').forEach((label) => {
				label.textContent = text
			})
		})
	}

	class ChameleonSkinSelect extends HTMLElement {
		#initialized = false

		connectedCallback() {
			if (this.#initialized) return
			this.#initialized = true

			const stored = loadSkin()
			const button = this.querySelector<HTMLButtonElement>('.skin-trigger')
			const menu = this.querySelector<HTMLElement>('.skin-menu')
			if (!button || !menu) {
				applySkin(stored)
				return
			}

			button.addEventListener('click', () => {
				this.#isOpen() ? this.#close() : this.#open()
			})

			button.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
					event.preventDefault()
					this.#open()
					this.#selectedOption()?.focus()
				}
			})

			this.querySelectorAll<HTMLButtonElement>('.skin-option').forEach((option) => {
				option.addEventListener('click', () => {
					this.#selectSkin(option.dataset.skinValue || '')
					this.#close()
					button.focus()
				})
			})

			menu.addEventListener('keydown', (event) => {
				const options = this.#options()
				const currentIndex = options.indexOf(document.activeElement as HTMLButtonElement)
				if (event.key === 'Escape') {
					event.preventDefault()
					this.#close()
					button.focus()
				}
				if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
					event.preventDefault()
					const direction = event.key === 'ArrowDown' ? 1 : -1
					options.at((currentIndex + direction + options.length) % options.length)?.focus()
				}
				if (event.key === 'Home') {
					event.preventDefault()
					options[0]?.focus()
				}
				if (event.key === 'End') {
					event.preventDefault()
					options.at(-1)?.focus()
				}
			})

			document.addEventListener('click', (event) => {
				if (!this.contains(event.target as Node)) this.#close()
			})

			applySkin(stored)
		}

		#selectSkin(skin: string) {
			storeSkin(skin)
			applySkin(skin)
		}

		#isOpen() {
			return this.querySelector('.skin-menu')?.hasAttribute('hidden') === false
		}

		#open() {
			this.querySelector('.skin-menu')?.removeAttribute('hidden')
			this.querySelector('.skin-trigger')?.setAttribute('aria-expanded', 'true')
		}

		#close() {
			this.querySelector('.skin-menu')?.setAttribute('hidden', '')
			this.querySelector('.skin-trigger')?.setAttribute('aria-expanded', 'false')
		}

		#options() {
			return Array.from(this.querySelectorAll<HTMLButtonElement>('.skin-option'))
		}

		#selectedOption() {
			return (
				this.querySelector<HTMLButtonElement>('.skin-option[aria-selected="true"]') ||
				this.querySelector<HTMLButtonElement>('.skin-option')
			)
		}
	}

	if (!customElements.get('chameleon-skin-select')) {
		customElements.define('chameleon-skin-select', ChameleonSkinSelect)
	}
</script>

<style>
	chameleon-skin-select {
		position: relative;
		display: flex;
		align-items: center;
	}

	.skin-trigger {
		--sl-label-icon-size: 0.875rem;
		--sl-caret-size: 1.25rem;
		--sl-inline-padding: 0.5rem;
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		border: 0;
		padding: 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: inherit;
		cursor: pointer;
	}

	.skin-trigger:hover {
		color: var(--sl-color-white);
	}

	[data-variant='select'] .skin-trigger {
		padding-block: 0.625rem;
		padding-inline: var(--sl-inline-padding) calc(
				var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem
			);
		margin-inline: calc(var(--sl-inline-padding) * -1);
		inline-size: 11.75rem;
		text-align: start;
	}

	.selected-skin {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.caret {
		position: absolute;
		top: 50%;
		inset-inline-end: var(--sl-inline-padding);
		inline-size: var(--sl-caret-size);
		block-size: var(--sl-caret-size);
		transform: translateY(-50%);
		pointer-events: none;
	}

	[data-variant='icon'] .skin-trigger {
		justify-content: center;
		inline-size: 2rem;
		block-size: 2rem;
		color: var(--sl-color-text-accent);
	}

	.skin-trigger:focus {
		outline: none;
	}

	.skin-trigger:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 0.125rem;
		border-radius: 0.25rem;
	}

	.skin-menu {
		position: absolute;
		z-index: 10;
		inset-block-start: calc(100% + 0.375rem);
		inset-inline-end: 0;
		min-inline-size: 13rem;
		padding: 0.35rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		background-color: var(--sl-color-bg-nav);
		box-shadow: var(--sl-shadow-md);
	}

	.skin-menu[hidden] {
		display: none;
	}

	.skin-menu-heading {
		padding: 0.25rem 0.4rem 0.35rem;
		border-block-end: 1px solid var(--sl-color-gray-5);
		margin-block-end: 0.35rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.skin-option {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		inline-size: 100%;
		border: 0;
		border-radius: 0.25rem;
		padding: 0.4rem;
		background: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
		font: inherit;
		font-size: var(--sl-text-sm);
		text-align: start;
		white-space: nowrap;
		cursor: pointer;
	}

	/* Skins don't define --sl-color-bg-nav, so re-derive the swatch surface
	   from the skin's own palette (mirroring Starlight's mode mapping)
	   rather than inheriting the page's. */
	.preview[data-skin] {
		--sl-color-bg-nav: var(--sl-color-gray-6);
	}

	:global([data-theme='light']) .preview[data-skin] {
		--sl-color-bg-nav: var(--sl-color-gray-7);
	}

	/* The unskinned option's swatch shows Starlight's own palette, which the
	   page variables no longer hold once a skin is active. */
	.preview:not([data-skin]) {
		--sl-color-gray-2: hsl(224, 6%, 77%);
		--sl-color-gray-4: hsl(224, 7%, 36%);
		--sl-color-gray-5: hsl(224, 10%, 23%);
		--sl-color-gray-6: hsl(224, 14%, 16%);
		--sl-color-accent: hsl(224, 100%, 60%);
		--sl-color-bg-nav: var(--sl-color-gray-6);
	}

	:global([data-theme='light']) .preview:not([data-skin]) {
		--sl-color-gray-2: hsl(224, 10%, 23%);
		--sl-color-gray-4: hsl(224, 6%, 56%);
		--sl-color-gray-5: hsl(224, 6%, 77%);
		--sl-color-gray-6: hsl(224, 20%, 94%);
		--sl-color-accent: hsl(234, 90%, 60%);
		--sl-color-bg-nav: hsl(0, 0%, 100%);
	}

	.skin-option:focus,
	.skin-option[aria-selected='true'] {
		outline: none;
		background-color: var(--sl-color-gray-6);
		color: var(--sl-color-white);
	}

	.preview {
		flex: 0 0 auto;
		inline-size: 2.65rem;
		block-size: 1.7rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.25rem;
		padding: 0.2rem;
	}

	.preview-surface {
		display: grid;
		gap: 0.18rem;
		block-size: 100%;
		border-radius: 0.125rem;
		padding: 0.2rem;
		background: var(--sl-color-bg-nav);
	}

	.preview-accent {
		inline-size: 45%;
		block-size: 0.2rem;
		border-radius: 999px;
		background: var(--sl-color-accent);
	}

	.preview-line {
		inline-size: 80%;
		block-size: 0.16rem;
		border-radius: 999px;
		background: var(--sl-color-gray-2);
	}

	.preview-line.short {
		inline-size: 55%;
		background: var(--sl-color-gray-4);
	}

	.skin-name {
		overflow: hidden;
		text-overflow: ellipsis;
		color: var(--sl-color-text);
	}

	@media (min-width: 50rem) {
		.skin-trigger {
			font-size: var(--sl-text-sm);
		}
	}
</style>
