---
import DefaultThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro'

import config from 'virtual:starlight-theme-chameleon/config'
import ThemeModeButton from './ThemeModeButton.astro'

const t = Astro.locals.t

// The skin selector's one localized string. When the key resolves nowhere —
// the site's default locale is outside the shipped set and the site added no
// translation — fall back to English rather than announcing the raw key.
const labelKey = 'starlightThemeChameleon.skinSelect.accessibleLabel'
const accessibleLabel = t.exists(labelKey) ? t(labelKey) : 'Select skin'

// Skin names are proper nouns and never translated (ADR 0004). That includes
// the first entry: the unskinned look is named after what it is — Starlight.
const options = [
  { label: 'Starlight', value: '' },
  ...config.skins.map((skin) => ({ label: skin.label, value: skin.name })),
]
---

{
  config.skinSelector !== 'hidden' && (
    <chameleon-skin-select data-variant={config.skinSelector}>
      <label>
        <span class="sr-only">{accessibleLabel}</span>
        {/* The plugin's namesake: a chameleon with a curled tail. */}
        <svg
          class="icon"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          width="16"
          height="16"
        >
          <path
            fill-rule="evenodd"
            d="M2.6 14.6 a3.2 3.2 0 1 0 6.4 0 a3.2 3.2 0 1 0 -6.4 0 Z M4.55 14.6 a1.25 1.25 0 1 0 2.5 0 a1.25 1.25 0 1 0 -2.5 0 Z"
          />
          <path
            fill-rule="evenodd"
            d="M8.3 14.9 C7.9 11.6 10.2 8.4 13.6 8 C15.3 7.8 16.9 8 18.1 8.6 C18.3 7.7 19.4 7.3 20.2 7.8 C21 8.3 21.4 9.1 21.2 9.9 C21.9 10.2 22.2 10.8 22 11.2 C21.2 11.6 20.2 11.6 19.4 11.3 C18.8 12.3 17.8 13.1 16.8 13.4 C14.2 14.3 10.9 14.9 8.3 14.9 Z M18.15 9.3 a0.85 0.85 0 1 0 1.7 0 a0.85 0.85 0 1 0 -1.7 0 Z"
          />
          <path d="M11.2 14.6 l-0.5 3 l1.3 0.1 l0.6 -2.9 Z M15.8 13.6 l-0.3 3.2 l1.3 0 l0.4 -3.1 Z" />
        </svg>
        <select autocomplete="off">
          {options.map(({ value, label }) => (
            <option value={value} selected={value === ''} set:html={label} />
          ))}
        </select>
        <svg
          class="caret"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          width="16"
          height="16"
        >
          <path d="M17 9.17a1 1 0 0 0-1.41 0L12 12.71 8.46 9.17a1 1 0 1 0-1.41 1.42l4.24 4.24a1 1 0 0 0 1.42 0L17 10.59a1 1 0 0 0 0-1.42Z" />
        </svg>
      </label>
    </chameleon-skin-select>
  )
}
{
  config.themeSelector === 'icon'
    ? <ThemeModeButton><slot /></ThemeModeButton>
    : <DefaultThemeSelect><slot /></DefaultThemeSelect>
}

{/* Inlined to avoid a flash of the wrong selector value on load. */}
<script is:inline>
	(() => {
		var stored = '';
		try {
			stored = localStorage.getItem('starlight-skin') || '';
		} catch (e) {}
		document.querySelectorAll('chameleon-skin-select select').forEach((select) => {
			if (stored && select.querySelector('option[value="' + stored + '"]')) select.value = stored;
		});
	})();
</script>

<script>
	/** Key in `localStorage` to store the skin preference at. */
	const storageKey = 'starlight-skin'

	const loadSkin = (): string => {
		try {
			return localStorage.getItem(storageKey) || ''
		} catch {
			return ''
		}
	}

	const storeSkin = (skin: string): void => {
		try {
			if (skin) localStorage.setItem(storageKey, skin)
			else localStorage.removeItem(storageKey)
		} catch {
			/* Persistence is best-effort. */
		}
	}

	/** Flip the `data-skin` attribute and keep every selector instance in sync. */
	const applySkin = (skin: string): void => {
		if (skin) document.documentElement.dataset.skin = skin
		else delete document.documentElement.dataset.skin
		document
			.querySelectorAll<HTMLSelectElement>('chameleon-skin-select select')
			.forEach((select) => {
				select.value = skin
			})
	}

	class ChameleonSkinSelect extends HTMLElement {
		constructor() {
			super()
			const select = this.querySelector('select')
			if (!select) return
			const stored = loadSkin()
			if (stored && select.querySelector(`option[value="${CSS.escape(stored)}"]`)) {
				select.value = stored
			}
			select.addEventListener('change', (event) => {
				if (event.currentTarget instanceof HTMLSelectElement) {
					const skin = event.currentTarget.value
					storeSkin(skin)
					applySkin(skin)
				}
			})
		}
	}

	if (!customElements.get('chameleon-skin-select')) {
		customElements.define('chameleon-skin-select', ChameleonSkinSelect)
	}
</script>

<style>
	chameleon-skin-select {
		display: flex;
		align-items: center;
	}

	label {
		--sl-label-icon-size: 0.875rem;
		--sl-caret-size: 1.25rem;
		--sl-inline-padding: 0.5rem;
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.25rem;
		color: var(--sl-color-gray-2);
	}

	label:hover {
		color: var(--sl-color-white);
	}

	label:focus-within {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 0.125rem;
		border-radius: 0.25rem;
	}

	.icon {
		position: absolute;
		top: 50%;
		inset-inline-start: 0;
		inline-size: var(--sl-label-icon-size);
		block-size: var(--sl-label-icon-size);
		transform: translateY(-50%);
		pointer-events: none;
	}

	select {
		border: 0;
		padding-block: 0.625rem;
		padding-inline: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.25rem)
			calc(var(--sl-caret-size) + var(--sl-inline-padding) + 0.25rem);
		margin-inline: calc(var(--sl-inline-padding) * -1);
		inline-size: 11.75rem;
		background-color: transparent;
		color: inherit;
		text-overflow: ellipsis;
		cursor: pointer;
		appearance: none;
	}

	.caret {
		position: absolute;
		top: 50%;
		inset-inline-end: 0;
		inline-size: var(--sl-caret-size);
		block-size: var(--sl-caret-size);
		transform: translateY(-50%);
		pointer-events: none;
	}

	[data-variant='icon'] label {
		justify-content: center;
		inline-size: 2rem;
		block-size: 2rem;
	}

	[data-variant='icon'] .icon {
		position: static;
		inline-size: 1.25rem;
		block-size: 1.25rem;
		transform: none;
	}

	[data-variant='icon'] select {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		padding: 0;
		margin: 0;
		opacity: 0;
	}

	[data-variant='icon'] .caret {
		display: none;
	}

	option {
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
	}

	@media (min-width: 50rem) {
		select {
			font-size: var(--sl-text-sm);
		}
	}
</style>
