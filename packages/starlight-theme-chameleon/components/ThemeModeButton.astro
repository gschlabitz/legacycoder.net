---
type Theme = 'auto' | 'dark' | 'light'

const t = Astro.locals.t
const selectLabel = t('themeSelect.accessibleLabel')
const labels: Record<Theme, string> = {
	auto: t('themeSelect.auto'),
	dark: t('themeSelect.dark'),
	light: t('themeSelect.light'),
}
---

<starlight-theme-select
	data-mode="auto"
	data-label={selectLabel}
	data-label-auto={labels.auto}
	data-label-dark={labels.dark}
	data-label-light={labels.light}
>
	<button type="button" class="mode-button" aria-label={`${selectLabel}: ${labels.auto}`} title={labels.auto}>
		<span class="mode-icon" data-mode-icon="light" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
				<path
					d="M5 12a1 1 0 0 0-1-1H3a1 1 0 0 0 0 2h1a1 1 0 0 0 1-1Zm.64 5-.71.71a1 1 0 0 0 0 1.41 1 1 0 0 0 1.41 0l.71-.71A1 1 0 0 0 5.64 17ZM12 5a1 1 0 0 0 1-1V3a1 1 0 0 0-2 0v1a1 1 0 0 0 1 1Zm5.66 2.34a1 1 0 0 0 .7-.29l.71-.71a1 1 0 1 0-1.41-1.41l-.66.71a1 1 0 0 0 0 1.41 1 1 0 0 0 .66.29Zm-12-.29a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.71-.71a1.004 1.004 0 1 0-1.43 1.41l.73.71ZM21 11h-1a1 1 0 0 0 0 2h1a1 1 0 0 0 0-2Zm-2.64 6A1 1 0 0 0 17 18.36l.71.71a1 1 0 0 0 1.41 0 1 1 0 0 0 0-1.41l-.76-.66ZM12 6.5a5.5 5.5 0 1 0 5.5 5.5A5.51 5.51 0 0 0 12 6.5Zm0 9a3.5 3.5 0 1 1 0-7 3.5 3.5 0 0 1 0 7Zm0 3.5a1 1 0 0 0-1 1v1a1 1 0 0 0 2 0v-1a1 1 0 0 0-1-1Z">
				</path>
			</svg>
		</span>
		<span class="mode-icon" data-mode-icon="dark" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
				<path
					d="M21.64 13a1 1 0 0 0-1.05-.14 8.049 8.049 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .25-2A1 1 0 0 0 8 2.36a10.14 10.14 0 1 0 14 11.69 1 1 0 0 0-.36-1.05Zm-9.5 6.69A8.14 8.14 0 0 1 7.08 5.22v.27a10.15 10.15 0 0 0 10.14 10.14 9.784 9.784 0 0 0 2.1-.22 8.11 8.11 0 0 1-7.18 4.32v-.04Z">
				</path>
			</svg>
		</span>
		<span class="mode-icon auto-icon" data-mode-icon="auto" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="16" height="16" fill="none">
				<path
					d="M12 3v3M12 18v3M5.64 5.64l2.12 2.12M3 12h3M5.64 18.36l2.12-2.12"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"></path>
				<path d="M12 7a5 5 0 0 0 0 10V7Z" fill="currentColor"></path>
				<path
					d="M14.25 4.4a7.8 7.8 0 0 0 5.35 13.35A7.8 7.8 0 0 1 12.25 21 8.95 8.95 0 0 1 12 3c.78 0 1.53.1 2.25.4Z"
					fill="currentColor"></path>
			</svg>
		</span>
	</button>
</starlight-theme-select>

{/* Inlined so the icon and tooltip match the stored preference before the bundled script runs. */}
<script is:inline>
	(() => {
		const parseTheme = (theme) => theme === 'dark' || theme === 'light' ? theme : 'auto';
		const labelFor = (picker, theme) => picker.dataset[`label${theme[0].toUpperCase()}${theme.slice(1)}`] || theme;
		const applyButtonState = (picker, theme) => {
			const button = picker.querySelector('button');
			const modeLabel = labelFor(picker, theme);
			picker.dataset.mode = theme;
			if (button) {
				button.title = modeLabel;
				button.setAttribute('aria-label', `${picker.dataset.label || ''}: ${modeLabel}`);
			}
		};

		let storedTheme = null;
		try {
			storedTheme = localStorage.getItem('starlight-theme');
		} catch (e) {}

		const theme = parseTheme(storedTheme);
		document.querySelectorAll('starlight-theme-select').forEach((picker) => applyButtonState(picker, theme));
	})();
</script>

<script>
	type Theme = 'auto' | 'dark' | 'light'

	const storageKey = 'starlight-theme'
	const themes: Theme[] = ['auto', 'light', 'dark']

	const parseTheme = (theme: unknown): Theme =>
		theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto'

	const loadTheme = (): Theme => {
		try {
			return parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey))
		} catch {
			return 'auto'
		}
	}

	function storeTheme(theme: Theme): void {
		try {
			if (typeof localStorage !== 'undefined') {
				localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '')
			}
		} catch {
			/* Persistence is best-effort. */
		}
	}

	const getPreferredColorScheme = (): Exclude<Theme, 'auto'> =>
		matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'

	const labelFor = (picker: HTMLElement, theme: Theme): string => {
		const key = `label${theme[0].toUpperCase()}${theme.slice(1)}` as 'labelAuto' | 'labelDark' | 'labelLight'
		return picker.dataset[key] || theme
	}

	function updateButton(picker: HTMLElement, theme: Theme): void {
		const button = picker.querySelector('button')
		const modeLabel = labelFor(picker, theme)
		picker.dataset.mode = theme
		if (button) {
			button.title = modeLabel
			button.setAttribute('aria-label', `${picker.dataset.label || ''}: ${modeLabel}`)
		}
	}

	function updateButtons(theme: Theme): void {
		document.querySelectorAll<HTMLElement>('starlight-theme-select').forEach((picker) => {
			updateButton(picker, theme)
		})
	}

	function onThemeChange(theme: Theme): void {
		const themeProvider = (
			window as unknown as Window & {
				StarlightThemeProvider: { updatePickers(theme?: Theme): void }
			}
		).StarlightThemeProvider
		themeProvider.updatePickers(theme)
		document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme
		storeTheme(theme)
		updateButtons(theme)
	}

	function nextTheme(theme: Theme): Theme {
		return themes[(themes.indexOf(theme) + 1) % themes.length] || 'auto'
	}

	matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
		if (loadTheme() === 'auto') onThemeChange('auto')
	})

	class StarlightThemeSelect extends HTMLElement {
		connectedCallback(): void {
			if (this.dataset.modeButtonReady) return
			this.dataset.modeButtonReady = 'true'
			onThemeChange(loadTheme())
			this.querySelector('button')?.addEventListener('click', () => {
				onThemeChange(nextTheme(loadTheme()))
			})
		}
	}

	if (!customElements.get('starlight-theme-select')) {
		customElements.define('starlight-theme-select', StarlightThemeSelect)
	}
</script>

<style>
	starlight-theme-select {
		display: flex;
		align-items: center;
	}

	.mode-button {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 2rem;
		block-size: 2rem;
		padding: 0;
		border: 0;
		border-radius: 0.25rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}

	.mode-button:hover {
		color: var(--sl-color-white);
	}

	.mode-button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 0.125rem;
	}

	.mode-icon {
		position: absolute;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 1.125rem;
		block-size: 1.125rem;
		opacity: 0;
		transform: scale(0.88);
		transition:
			opacity 120ms ease,
			transform 120ms ease;
		pointer-events: none;
	}

	.mode-icon svg {
		inline-size: 1.125rem;
		block-size: 1.125rem;
	}

	starlight-theme-select[data-mode='auto'] [data-mode-icon='auto'],
	starlight-theme-select[data-mode='dark'] [data-mode-icon='dark'],
	starlight-theme-select[data-mode='light'] [data-mode-icon='light'] {
		opacity: 1;
		transform: scale(1);
	}
</style>
