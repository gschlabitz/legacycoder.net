---
import config from 'virtual:starlight-pulsar/config'

const t = Astro.locals.t

// Localized UI strings. Tune labels are not among them — they are proper nouns
// chosen by the site author, like skin names.
// Keys are spelled out rather than built from a helper: Starlight's `t` is
// overloaded on a union of literal keys, so a computed key widens to `string`
// and stops typechecking. Each falls back to English rather than announcing a
// raw key, for sites whose default locale is outside the shipped set.
const accessibleLabel = t.exists('starlightPulsar.tuneSelect.accessibleLabel')
  ? t('starlightPulsar.tuneSelect.accessibleLabel')
  : 'Select background music'
const offLabel = t.exists('starlightPulsar.tuneSelect.off') ? t('starlightPulsar.tuneSelect.off') : 'Off'
const autoLabel = t.exists('starlightPulsar.tuneSelect.auto') ? t('starlightPulsar.tuneSelect.auto') : 'Auto'
const playLabel = t.exists('starlightPulsar.tuneSelect.play')
  ? t('starlightPulsar.tuneSelect.play')
  : 'Play background music'
const pauseLabel = t.exists('starlightPulsar.tuneSelect.pause')
  ? t('starlightPulsar.tuneSelect.pause')
  : 'Pause background music'
const previousLabel = t.exists('starlightPulsar.tuneSelect.previous')
  ? t('starlightPulsar.tuneSelect.previous')
  : 'Previous tune'
const nextLabel = t.exists('starlightPulsar.tuneSelect.next') ? t('starlightPulsar.tuneSelect.next') : 'Next tune'
const stopLabel = t.exists('starlightPulsar.tuneSelect.stop')
  ? t('starlightPulsar.tuneSelect.stop')
  : 'Stop and turn off'
const nothingLabel = t.exists('starlightPulsar.tuneSelect.nothing')
  ? t('starlightPulsar.tuneSelect.nothing')
  : 'Nothing here'

// What this page contributes: a Declared tune, a Silent page, or nothing.
const music = Astro.locals.starlightRoute?.entry?.data?.music as string | false | undefined
const silent = music === false
const pageTune = typeof music === 'string' ? music : null

// A page naming a tune that was never registered would go quietly silent —
// and because `music` is a mirrored fact, a typo in one locale's file would
// leave that locale's readers with nothing while the other plays. Cheaper to
// fail the build.
if (pageTune && !config.tunes.some((tune) => tune.name === pageTune)) {
  const known = config.tunes.map((tune) => tune.name).join(', ') || '(none registered)'
  throw new Error(
    `starlight-pulsar: page "${Astro.locals.starlightRoute?.id ?? Astro.url.pathname}" declares ` +
      `\`music: ${pageTune}\`, which is not a registered tune. Registered tunes: ${known}.`
  )
}

// The playlist lists Auto and the tunes. Off is not an entry — Stop is how a
// reader turns the site quiet, the way a transport works.
const entries = [{ value: 'auto', label: autoLabel }, ...config.tunes.map((tune) => ({ value: tune.name, label: tune.label }))]
---

<pulsar-tune-select
  data-page-tune={pageTune ?? ''}
  data-silent={silent ? 'true' : 'false'}
  data-label-play={playLabel}
  data-label-pause={pauseLabel}
  data-label-off={offLabel}
  data-label-nothing={nothingLabel}
>
  {/* The whole player, in the header. A reader should be able to see what is
      playing and stop it without opening anything — so the scope, the track
      name and the transport all live out here, and Eject is only for changing
      the track. Parts drop out as the header narrows (see the media queries):
      the scope goes first, then previous/next, because knowing what is playing
      and being able to stop it outrank both. */}
  <div class="pulsar-strip">
    <canvas class="pulsar-scope" data-scope width="80" height="36" aria-hidden="true"></canvas>

    {/* Marquee. The tempo rides along as a tooltip rather than more pixels. */}
    <span class="pulsar-title" data-title>{nothingLabel}</span>

    <div class="pulsar-transport" role="group" aria-label={accessibleLabel}>
      <button class="pulsar-btn pulsar-btn--skip" type="button" data-action="prev" aria-label={previousLabel}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="12" height="12">
          <path d="M7 5.5h2.4v13H7zM20 5.9v12.2a.8.8 0 0 1-1.24.67l-9.1-6.1a.8.8 0 0 1 0-1.34l9.1-6.1A.8.8 0 0 1 20 5.9Z" />
        </svg>
      </button>

      {/* Play and pause share a button here rather than taking two slots of a
          header that has none to spare. It is also the honest control: stopping
          writes a Bookmark and the next play resumes from it, so the tune is
          paused, not reset. */}
      <button class="pulsar-btn pulsar-trigger" type="button" data-action="playpause" data-state="nothing" aria-label={playLabel}>
        <svg class="pulsar-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="12" height="12">
          <path class="pulsar-glyph-play" d="M8 5.14v13.72a1 1 0 0 0 1.54.84l10.3-6.86a1 1 0 0 0 0-1.68L9.54 4.3A1 1 0 0 0 8 5.14Z" />
          <path class="pulsar-glyph-pause" d="M6.5 4.5h3.6v15H6.5zM13.9 4.5h3.6v15h-3.6z" />
        </svg>
      </button>

      <button class="pulsar-btn" type="button" data-action="stop" aria-label={stopLabel}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="12" height="12">
          <rect x="5" y="5" width="14" height="14" rx="1.2" />
        </svg>
      </button>

      <button class="pulsar-btn pulsar-btn--skip" type="button" data-action="next" aria-label={nextLabel}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="12" height="12">
          <path d="M14.6 5.5H17v13h-2.4zM4 5.9v12.2a.8.8 0 0 0 1.24.67l9.1-6.1a.8.8 0 0 0 0-1.34l-9.1-6.1A.8.8 0 0 0 4 5.9Z" />
        </svg>
      </button>
    </div>

    {/* Eject is now only the track list — what the button has meant since tape
        decks: not "stop", but "show me what else goes in here". */}
    <button class="pulsar-eject" type="button" aria-haspopup="listbox" aria-expanded="false" aria-label={accessibleLabel}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="12" height="12">
        <path d="M12.72 4.7a1 1 0 0 0-1.44 0l-7.2 8.6A1 1 0 0 0 4.8 15h14.4a1 1 0 0 0 .72-1.7Z" />
        <rect x="4" y="17.2" width="16" height="2.8" rx="0.7" />
      </svg>
    </button>
  </div>

  <div class="pulsar-panel" hidden>
    <div class="pulsar-list" role="listbox" aria-label={accessibleLabel}>
      {entries.map(({ value, label }, index) => (
        <button class="pulsar-option" type="button" role="option" data-tune-value={value} aria-selected={value === 'auto' ? 'true' : 'false'}>
          <span class="pulsar-option-index">{value === 'auto' ? '—' : String(index).padStart(2, '0')}</span>
          <span class="pulsar-option-name">{label}</span>
        </button>
      ))}
    </div>
  </div>
</pulsar-tune-select>

{/* Inlined so the control never paints a state the reader did not choose. */}
<script is:inline>
	(() => {
		var selection = 'auto';
		try {
			selection = localStorage.getItem('pulsar-selection') || 'auto';
		} catch (e) {}
		document.querySelectorAll('pulsar-tune-select').forEach((control) => {
			var values = Array.from(control.querySelectorAll('[data-tune-value]')).map((o) => o.getAttribute('data-tune-value'));
			// `off` is a real selection with no playlist entry — Stop owns it.
			if (selection !== 'off' && values.indexOf(selection) === -1) selection = 'auto';
			control.querySelectorAll('[data-tune-value]').forEach((option) => {
				option.setAttribute('aria-selected', option.getAttribute('data-tune-value') === selection ? 'true' : 'false');
			});
			var pageTune = control.getAttribute('data-page-tune') || '';
			var silent = control.getAttribute('data-silent') === 'true';
			var effective = selection === 'off' || silent ? '' : selection === 'auto' ? pageTune : selection;
			var state = selection === 'off' ? 'off' : effective ? 'armed' : 'nothing';
			control.querySelectorAll('.pulsar-trigger').forEach((node) => {
				node.setAttribute('data-state', state);
			});
		});
	})();
</script>

<script>
	import config, { tuneLoaders } from 'virtual:starlight-pulsar/config'
	import type { Tune } from 'starlight-pulsar/tune'

	const SELECTION_KEY = 'pulsar-selection'
	const BOOKMARKS_KEY = 'pulsar-bookmarks'

	/** Id the `analyze` control routes audio to, and the scope reads back from. */
	const ANALYSER_ID = 'pulsar'

	type Selection = 'auto' | 'off' | (string & {})

	const tuneNames = config.tunes.map((tune) => tune.name)

	/* Storage is best-effort throughout: a reader with storage blocked gets a
	   working control that simply forgets between pages. */
	const loadSelection = (): Selection => {
		try {
			const stored = localStorage.getItem(SELECTION_KEY)
			if (stored === 'off' || stored === 'auto') return stored
			if (stored && tuneNames.includes(stored)) return stored
		} catch {
			/* ignore */
		}
		return 'auto'
	}

	const storeSelection = (value: Selection): void => {
		try {
			localStorage.setItem(SELECTION_KEY, value)
		} catch {
			/* ignore */
		}
	}

	const loadBookmarks = (): Record<string, number> => {
		try {
			const raw = localStorage.getItem(BOOKMARKS_KEY)
			const parsed: unknown = raw ? JSON.parse(raw) : null
			if (parsed && typeof parsed === 'object') return parsed as Record<string, number>
		} catch {
			/* ignore */
		}
		return {}
	}

	const storeBookmark = (name: string, cycle: number): void => {
		if (!Number.isFinite(cycle) || cycle < 0) return
		try {
			const bookmarks = loadBookmarks()
			bookmarks[name] = cycle
			localStorage.setItem(BOOKMARKS_KEY, JSON.stringify(bookmarks))
		} catch {
			/* ignore */
		}
	}

	/* ------------------------------------------------------------------ */
	/* Engine                                                              */
	/* ------------------------------------------------------------------ */

	interface Repl {
		setCps(cps: number): void
		setPattern(pattern: unknown, autostart?: boolean): Promise<unknown>
		stop(): void
	}

	interface StrudelModule {
		initStrudel(options: Record<string, unknown>): Promise<unknown>
		getAudioContext(): AudioContext
		getAnalyserById(id: string, fftSize?: number, smoothing?: number): AnalyserNode
		getAnalyzerData(type: 'time' | 'frequency', id?: string): Float32Array
		samples(map: unknown, base: string): unknown
	}

	let audioContext: AudioContext | null = null
	let strudelModule: StrudelModule | null = null

	/* Module scope, shared by every control instance on the page: the first
	   play downloads the engine, later plays reuse the same promise. Nothing
	   is imported until a reader actually asks for sound (ADR 0005). */
	let enginePromise: Promise<Repl> | null = null

	const loadEngine = (): Promise<Repl> => {
		enginePromise ??= (async () => {
			const strudel = (await import('@strudel/web')) as unknown as StrudelModule
			const options: Record<string, unknown> = {}
			/* `initStrudel` registers synth sounds on its own and fetches nothing.
			   A prebake is added only when the site brought its own samples —
			   which is what keeps built-in tunes network-free. */
			if (config.samples) {
				const { base, map } = config.samples
				options.prebake = () => strudel.samples(map, base)
			}
			const repl = (await strudel.initStrudel(options)) as Repl
			strudelModule = strudel
			audioContext = strudel.getAudioContext()
			return repl
		})()
		/* Don't let one failed load poison every later attempt: a cached rejected
		   promise would make the transport permanently dead until a reload. */
		enginePromise.catch(() => {
			enginePromise = null
		})
		return enginePromise
	}

	/* Tune metadata, cached as modules load, so the readout can show a tempo
	   without re-importing. */
	const tuneCache = new Map<string, Tune>()

	/* What is sounding right now, if anything.

	   Position is derived from audio time rather than `scheduler.now()`. The
	   scheduler's cycle clock does not advance at `cps` across a stop/start —
	   measured 0.147 cycles/s while `getCps()` read 0.06 — so a bookmark taken
	   from it lands in the wrong place. Audio time times the tune's own cps
	   uses only values we set, and is what the reader actually heard. */
	let playing: { name: string; startedAt: number; offset: number; cps: number } | null = null

	/* Playback and selection are page-wide, not per-control: Starlight renders
	   SocialIcons twice — desktop header and mobile menu — so both instances
	   must show the same state or they contradict each other. */
	let selection: Selection = 'auto'

	const play = async (name: string): Promise<boolean> => {
		const loader = tuneLoaders[name]
		if (!loader) return false

		const [repl, module] = await Promise.all([loadEngine(), loader()])
		const tune: Tune = module.default
		tuneCache.set(name, tune)

		/* Resume on a downbeat. Strudel's Cyclist only fires haps that have an
		   onset, so resuming mid-cycle drops any note spanning the resume point
		   instead of splicing it — rounding forward is what avoids that. */
		const offset = Math.ceil(loadBookmarks()[name] ?? 0)
		let pattern = tune.pattern()
		if (offset > 0) pattern = pattern.early(offset)
		if (typeof tune.gain === 'number') {
			/* `.mul(gain(x))` scales; a bare `.gain(x)` would overwrite the
			   per-voice levels the tune set for its own balance. `gain` is one of
			   the controls `initStrudel` puts on `globalThis`. */
			const gainControl = (globalThis as unknown as { gain: (value: number) => unknown }).gain
			pattern = pattern.mul(gainControl(tune.gain))
		}
		/* Route through a named analyser so the scope has something to read.
		   Without this the visualizer would be a flat line. */
		pattern = pattern.analyze(ANALYSER_ID)

		repl.setCps(tune.cps)
		await repl.setPattern(pattern, true)
		playing = { name, startedAt: audioContext?.currentTime ?? 0, offset, cps: tune.cps }
		startScope()
		return true
	}

	const bookmarkNow = (): void => {
		if (!playing) return
		const elapsed = (audioContext?.currentTime ?? playing.startedAt) - playing.startedAt
		storeBookmark(playing.name, playing.offset + elapsed * playing.cps)
	}

	const pause = async (): Promise<void> => {
		if (!playing || !enginePromise) return
		const repl = await enginePromise
		bookmarkNow()
		/* No master fade: `outputNode` reaches only Strudel's ugen path, not
		   superdough's `s()`/`note()` output, so there is no master node to ramp.
		   `stop()` halts scheduling and lets sounding notes finish their own
		   release, which is a cleaner exit than a cut anyway. */
		repl.stop()
		playing = null
		stopScope()
	}

	/* A tune that is sounding when the document goes away still deserves its
	   bookmark. `pagehide` rather than `beforeunload`, which disqualifies the
	   page from the back/forward cache. Fully synchronous: audio time and
	   `localStorage` are both available without awaiting. */
	window.addEventListener('pagehide', () => {
		bookmarkNow()
	})

	/* ------------------------------------------------------------------ */
	/* Scope                                                               */
	/* ------------------------------------------------------------------ */

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
	let scopeFrame = 0

	/** Size a canvas to its CSS box at device resolution, once it has one. */
	const sizeScope = (canvas: HTMLCanvasElement): void => {
		const ratio = window.devicePixelRatio || 1
		const width = Math.round(canvas.clientWidth * ratio)
		const height = Math.round(canvas.clientHeight * ratio)
		if (width > 0 && height > 0 && (canvas.width !== width || canvas.height !== height)) {
			canvas.width = width
			canvas.height = height
		}
	}

	/**
	 * One frame of oscilloscope per visible canvas.
	 *
	 * Stroke comes from the canvas's own computed `color`, so the trace follows
	 * whatever skin Chameleon has active — the whole reason for drawing into our
	 * own canvas instead of Strudel's full-screen `getDrawContext()` one.
	 */
	const drawScopes = (): void => {
		const samples = playing && strudelModule ? strudelModule.getAnalyzerData('time', ANALYSER_ID) : null

		document.querySelectorAll<HTMLCanvasElement>('[data-scope]').forEach((canvas) => {
			if (!canvas.clientWidth) return
			sizeScope(canvas)
			const ctx = canvas.getContext('2d')
			if (!ctx) return

			const { width, height } = canvas
			const middle = height / 2
			ctx.clearRect(0, 0, width, height)
			ctx.lineWidth = Math.max(1, (window.devicePixelRatio || 1) * 1.1)
			ctx.strokeStyle = getComputedStyle(canvas).color
			ctx.beginPath()

			/* Normalise to the buffer's own peak. Background music is quiet by
			   design and this canvas is under twenty pixels tall, so a fixed scale
			   draws something indistinguishable from silence. The cap stops near-
			   silence being amplified into noise, and the floor keeps a genuinely
			   silent buffer flat. */
			let peak = 0
			if (samples) for (let i = 0; i < samples.length; i++) peak = Math.max(peak, Math.abs(samples[i]!))
			const scale = peak > 0.002 ? Math.min(1 / peak, 14) : 0

			if (!samples || samples.length === 0 || scale === 0) {
				ctx.moveTo(0, middle)
				ctx.lineTo(width, middle)
			} else {
				const step = width / (samples.length - 1)
				for (let i = 0; i < samples.length; i++) {
					const value = Math.max(-1, Math.min(1, samples[i]! * scale * 0.9))
					const y = middle - value * (middle - 1)
					i === 0 ? ctx.moveTo(0, y) : ctx.lineTo(i * step, y)
				}
			}
			ctx.stroke()
		})
	}

	const scopeTick = (): void => {
		drawScopes()
		scopeFrame = requestAnimationFrame(scopeTick)
	}

	const startScope = (): void => {
		if (scopeFrame) return
		/* A visualizer is motion by definition, so honour the preference by
		   drawing the baseline once and leaving it still. */
		if (reducedMotion.matches) {
			drawScopes()
			return
		}
		scopeFrame = requestAnimationFrame(scopeTick)
	}

	const stopScope = (): void => {
		if (scopeFrame) cancelAnimationFrame(scopeFrame)
		scopeFrame = 0
		drawScopes()
	}

	/* ------------------------------------------------------------------ */
	/* Shared state → every control on the page                            */
	/* ------------------------------------------------------------------ */

	/**
	 * What should sound on this control's page, given page and reader. A silent
	 * page overrides the reader; Off suppresses everything; Auto defers to the
	 * page; an explicit pick plays anywhere that permits music.
	 */
	const effectiveFor = (control: HTMLElement): string => {
		const pageTune = control.dataset.pageTune || ''
		if (selection === 'off' || control.dataset.silent === 'true') return ''
		if (selection === 'auto') return pageTune
		return tuneNames.includes(selection) ? selection : ''
	}

	const renderAll = (): void => {
		document.querySelectorAll<HTMLElement>('pulsar-tune-select').forEach((control) => {
			const effective = effectiveFor(control)
			const state = selection === 'off' ? 'off' : playing ? 'playing' : effective ? 'armed' : 'nothing'

			const trigger = control.querySelector<HTMLButtonElement>('.pulsar-trigger')
			if (trigger) {
				trigger.dataset.state = state
				/* The glyph swaps play↔pause, so the label has to swap with it —
				   a button showing pause must not still announce "Play". */
				const label = state === 'playing' ? control.dataset.labelPause : control.dataset.labelPlay
				if (label) trigger.setAttribute('aria-label', label)
			}

			/* Readout: what is loaded. The tempo rides along as a tooltip — real
			   numbers, but not worth header pixels. */
			const shown = playing?.name || effective
			const tune = shown ? config.tunes.find((entry) => entry.name === shown) : undefined
			/* Two copies: the strip's, and the panel's for when the header is too
			   narrow to carry it. Both are always in the DOM; CSS decides which
			   one the reader sees. */
			const text =
				state === 'off'
					? control.dataset.labelOff || 'Off'
					: tune
						? tune.label
						: control.dataset.labelNothing || 'Nothing here'
			const cps = playing?.cps ?? (shown ? tuneCache.get(shown)?.cps : undefined)
			control.querySelectorAll<HTMLElement>('[data-title]').forEach((title) => {
				title.textContent = text
				if (tune && cps) title.title = `${tune.label} — ${cps.toFixed(2)} cps · ${(1 / cps).toFixed(1)}s`
				else title.removeAttribute('title')
			})

			/* Transport availability. Stop is Off, so it is spent once Off, and
			   a Silent page leaves nothing for the transport to do at all. */
			const hasTunes = config.tunes.length > 0
			const silentHere = control.dataset.silent === 'true'
			const set = (action: string, disabled: boolean) => {
				control.querySelectorAll<HTMLButtonElement>(`[data-action="${action}"]`).forEach((button) => {
					button.disabled = disabled
				})
			}
			set('prev', !hasTunes || silentHere)
			set('next', !hasTunes || silentHere)
			set('playpause', !hasTunes || silentHere)
			set('stop', state === 'off' || silentHere)

			control.querySelectorAll<HTMLElement>('[data-tune-value]').forEach((option) => {
				option.setAttribute('aria-selected', option.dataset.tuneValue === selection ? 'true' : 'false')
				/* Selection and what is loaded are different things — on Auto the
				   reader has picked "whatever this page says" while a specific tune
				   is sounding. Marking the loaded row keeps that legible. */
				option.toggleAttribute('data-loaded', Boolean(shown) && option.dataset.tuneValue === shown)
			})
		})

		/* The scope lives in the header now, so it is on screen even at rest and
		   needs its flat baseline drawn rather than left blank. While playing the
		   animation frame owns it and this is just a harmless extra frame. */
		drawScopes()
	}

	/* ------------------------------------------------------------------ */
	/* Control                                                             */
	/* ------------------------------------------------------------------ */

	class PulsarTuneSelect extends HTMLElement {
		#initialized = false

		connectedCallback() {
			if (this.#initialized) return
			this.#initialized = true

			selection = loadSelection()

			const trigger = this.querySelector<HTMLButtonElement>('.pulsar-trigger')
			const eject = this.querySelector<HTMLButtonElement>('.pulsar-eject')
			const panel = this.querySelector<HTMLElement>('.pulsar-panel')
			if (!trigger || !eject || !panel) return

			/* The transport button is itself a `[data-action]`, so the generic
			   handler below owns its click — binding here too would fire twice. */
			eject.addEventListener('click', () => {
				this.#isOpen() ? this.#close() : this.#open()
			})

			this.querySelectorAll<HTMLButtonElement>('[data-action]').forEach((button) => {
				button.addEventListener('click', () => {
					void this.#transport(button.dataset.action || '')
				})
			})

			this.querySelectorAll<HTMLButtonElement>('.pulsar-option').forEach((option) => {
				option.addEventListener('click', () => {
					/* Choosing an entry is itself the gesture browsers require, so
					   selection and playback are one interaction rather than two. */
					void this.#select(option.dataset.tuneValue || 'auto')
				})
			})

			panel.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape') return
				event.preventDefault()
				this.#close()
				eject.focus()
			})

			this.querySelector('.pulsar-panel')?.addEventListener('keydown', (event) => {
				const options = this.#options()
				const index = options.indexOf(document.activeElement as HTMLButtonElement)
				const key = (event as KeyboardEvent).key
				if (key === 'ArrowDown' || key === 'ArrowUp') {
					event.preventDefault()
					const direction = key === 'ArrowDown' ? 1 : -1
					options.at((index + direction + options.length) % options.length)?.focus()
				}
				if (key === 'Home') {
					event.preventDefault()
					options[0]?.focus()
				}
				if (key === 'End') {
					event.preventDefault()
					options.at(-1)?.focus()
				}
			})

			document.addEventListener('click', (event) => {
				if (!this.contains(event.target as Node)) this.#close()
			})

			renderAll()
		}

		/** Index of the tune currently loaded here, or -1 on Auto with nothing. */
		#currentIndex(): number {
			const current = playing?.name || effectiveFor(this)
			return current ? config.tunes.findIndex((tune) => tune.name === current) : -1
		}

		async #transport(action: string) {
			const count = config.tunes.length

			if (action === 'playpause') {
				await this.#toggle()
				return
			}

			if (action === 'stop') {
				/* Stop is Off. Deliberately *not* Winamp's rewind-to-zero: Off is a
				   preference meaning "stop offering", and bookmarks survive it the
				   same way they survive a Silent page. */
				await pause()
				selection = 'off'
				storeSelection(selection)
				renderAll()
				return
			}

			if ((action === 'prev' || action === 'next') && count > 0) {
				const step = action === 'next' ? 1 : -1
				const index = this.#currentIndex()
				const nextIndex = index === -1 ? (action === 'next' ? 0 : count - 1) : (index + step + count) % count
				await this.#select(config.tunes[nextIndex]!.name)
			}
		}

		async #toggle() {
			if (playing) {
				await pause()
				renderAll()
				return
			}

			/* A Silent page overrides the reader, so play cannot mean play here.
			   Offer the track list instead of doing nothing at all. */
			if (this.dataset.silent === 'true') {
				this.#open()
				return
			}

			/* Pressing play while Off is an explicit request for sound, so it
			   lifts Off rather than refusing. */
			if (selection === 'off') {
				selection = 'auto'
				storeSelection(selection)
			}

			let tune = effectiveFor(this)
			if (!tune) {
				/* This page declares nothing and the reader is on Auto. Pressing
				   play should still produce sound, so cue the first registered tune
				   and record it as a deliberate pick — Auto would silently do
				   nothing again on the next page. */
				const first = config.tunes[0]?.name
				if (!first) {
					this.#open()
					return
				}
				selection = first
				storeSelection(selection)
				tune = first
			}

			await play(tune)
			renderAll()
		}

		async #select(value: Selection) {
			const changed = value !== selection
			selection = value
			storeSelection(value)

			/* Switching away from a sounding tune bookmarks it first. */
			if (playing && changed) await pause()

			const tune = effectiveFor(this)
			if (tune) await play(tune)
			renderAll()
		}

		#isOpen() {
			return this.querySelector('.pulsar-panel')?.hasAttribute('hidden') === false
		}

		#open() {
			this.querySelector('.pulsar-panel')?.removeAttribute('hidden')
			this.querySelector('.pulsar-eject')?.setAttribute('aria-expanded', 'true')
			/* The canvas had no layout while hidden, so it has no usable size
			   until now. */
			renderAll()
			drawScopes()
		}

		#close() {
			this.querySelector('.pulsar-panel')?.setAttribute('hidden', '')
			this.querySelector('.pulsar-eject')?.setAttribute('aria-expanded', 'false')
		}

		#options() {
			return Array.from(this.querySelectorAll<HTMLButtonElement>('.pulsar-option'))
		}
	}

	if (!customElements.get('pulsar-tune-select')) {
		customElements.define('pulsar-tune-select', PulsarTuneSelect)
	}
</script>

