{
  "name": "starlight-pulsar",
  "version": "0.0.0",
  "private": true,
  "description": "Starlight plugin for page-scoped Strudel tunes selected per page and started by the reader.",
  "author": "Guido Schlabitz",
  "type": "module",
  "scripts": {
    "test": "node tests/player-click.mjs"
  },
  "keywords": [
    "starlight",
    "starlight-plugin",
    "astro",
    "strudel",
    "music",
    "audio"
  ],
  "exports": {
    ".": "./index.ts",
    "./tune": "./tune.ts",
    "./schema": "./schema.ts",
    "./components/*": "./components/*",
    "./tunes/*": "./tunes/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41",
    "@strudel/web": ">=1.3",
    "astro": ">=5"
  }
}
