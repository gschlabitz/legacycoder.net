---
// PROTOTYPE — issue #30. The index over the per-tune pages.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import config, { tuneLoaders } from "virtual:starlight-pulsar/config";

const tunes = await Promise.all(
  config.tunes.map(async ({ name, label }) => {
    const { default: tune } = await tuneLoaders[name]!();
    return { name, label, secondsPerCycle: 1 / tune.cps };
  }),
);
---

<StarlightPage
  frontmatter={{
    title: "Tunes",
    description: "The tunes this site plays, and the JavaScript that describes them.",
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <style>
    .tune-intro {
      color: var(--sl-color-gray-2);
      font-size: 1.1rem;
      line-height: 1.6;
      margin-bottom: 2rem;
    }
    .tune-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
      gap: 1rem;
    }
    .tune-card {
      display: block;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding: 1.25rem;
      text-decoration: none;
      color: inherit;
      transition: border-color 0.15s;
    }
    .tune-card:hover {
      border-color: var(--sl-color-accent);
    }
    .tune-card-title {
      margin: 0 0 0.5rem;
      font-size: 1.2rem;
      font-weight: 600;
    }
    .tune-card-meta {
      font-family: var(--sl-font-mono);
      font-size: 0.8rem;
      color: var(--sl-color-gray-1);
    }
  </style>

  <p class="tune-intro">
    Nothing here is a recording. Each tune is a few dozen lines of JavaScript
    describing oscillators and filters, evaluated in your browser by
    <a href="https://strudel.cc">Strudel</a> when you press play. Each page shows
    the code that makes it.
  </p>

  <ul class="tune-list">
    {
      tunes.map(({ name, label, secondsPerCycle }) => (
        <li>
          <a class="tune-card" href={`/tunes/${name}`}>
            <h2 class="tune-card-title">{label}</h2>
            <span class="tune-card-meta">{secondsPerCycle.toFixed(2)}s per cycle</span>
          </a>
        </li>
      ))
    }
  </ul>
</StarlightPage>
