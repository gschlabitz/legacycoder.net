---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { render } from "astro:content";
import TimelineFilter from "../components/TimelineFilter.jsx";
import TimelineMap from "../components/TimelineMap.jsx";
import TimelineOrder from "../components/TimelineOrder.jsx";
import { pinSvg, tagColor, tagIcon } from "../lib/tag-pins.js";
import { getTimelineEvents } from "../lib/timeline";

// Build-time: every blog post is a timeline event (ADR-0004). The loader
// returns them chronologically with sphere/summary/url derived.
const events = await getTimelineEvents();

// Group into year buckets, preserving that chronological order. Frontmatter
// dates parse as UTC midnight, so read them back in UTC too — local-time
// getters would shift a day-1 date into the previous month/year on any
// machine west of Greenwich.
const byYear = new Map<number, typeof events>();
for (const event of events) {
  const year = event.date.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(event);
}
const years = [...byYear.entries()];

// Display label for a place: "city, state" at home, "city, country" abroad —
// derived from the location parts so label and parts can't disagree (see the
// location schema in src/content.config.ts).
type Location = (typeof events)[number]["location"];
const placeLabel = (loc: Location) =>
  [loc.city, loc.state ?? loc.country].filter(Boolean).join(", ");

// Year headings read "Berlin, Germany - 1992": each year shows the city I
// lived in at the time, taken from the year's first event (every published
// event has a location — the timeline loader enforces it).
const placeByYear = new Map<number, string>();
for (const [year, yearEvents] of years) {
  placeByYear.set(year, placeLabel(yearEvents[0].location));
}

// Distinct tags, for the filter island's chips.
const allTags = [...new Set(events.flatMap((e) => e.tags))].sort();

// Tag icon for an event: its first tag decides (events carrying several
// tags lead with the defining one); untagged events keep the plain teardrop.
// Shared with the map via src/lib/tag-pins. Pins render in one shared color
// (PIN_COLOR); the per-tag color only tints the map placeholder's chips now.
const eventColor = (event: (typeof events)[number]) =>
  tagColor(event.tags[0], allTags);
const eventIcon = (event: (typeof events)[number]) => tagIcon(event.tags[0]);

// Pre-render Markdown bodies for events without an authored summary — the
// timeline shows the most deliberate summary available (excerpt ??
// description ?? full body). render() is async, so it can't run inside the
// template loop below.
const bodies = new Map<string, Awaited<ReturnType<typeof render>>["Content"]>();
for (const event of events) {
  if (event.summary !== null) continue;
  const { Content } = await render(event.entry);
  bodies.set(event.entry.id, Content);
}

const monthFmt = new Intl.DateTimeFormat("en-US", {
  month: "long",
  timeZone: "UTC",
});

// Group events by coordinate for the map banner: one pin per place (repeat
// locations would otherwise stack identical markers), revealed when the
// first of its events scrolls into view. Insertion order is chronological
// because `events` already is.
type Place = {
  lat: number;
  lng: number;
  label: string;
  color: string; // tag pin color, from the place's first (earliest) event
  icon: string | undefined; // tag icon markup, same source as color
  titles: string[];
  eventIds: string[];
};
const placesByCoord = new Map<string, Place>();
for (const event of events) {
  const loc = event.location;
  const key = `${loc.lat},${loc.lng}`;
  if (!placesByCoord.has(key)) {
    placesByCoord.set(key, {
      lat: loc.lat,
      lng: loc.lng,
      label: placeLabel(loc),
      color: eventColor(event),
      icon: eventIcon(event),
      titles: [],
      eventIds: [],
    });
  }
  const place = placesByCoord.get(key)!;
  place.titles.push(event.title);
  place.eventIds.push(event.entry.id);
}
const places = [...placesByCoord.values()];

// Client-side Maps JS keys are public by design (locked down by referrer
// restrictions), so passing it into island props is fine. Without a key the
// island renders a placeholder banner in dev and nothing in production.
const mapsApiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY as
  | string
  | undefined;
// Optional cloud-styled map ID; the island falls back to Google's sandbox
// DEMO_MAP_ID (advanced markers require some map ID).
const mapsMapId = import.meta.env.PUBLIC_GOOGLE_MAPS_MAP_ID as
  | string
  | undefined;
const showMap = places.length > 0 && (mapsApiKey || import.meta.env.DEV);
---

<StarlightPage
  frontmatter={{
    title: "Auto-Biography",
    description: "A timeline of where I have been and what I built.",
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <style>
    :global(h1:first-of-type) {
      display: none;
    }
  </style>
  {/* Static HTML defaults to newest-first (tl-newest-first flips the visual
      order of the chronologically-ordered DOM). The TimelineOrder island
      reconciles this with the ?order= param after hydration — ?order=oldest
      removes the class again. */}
  <div class="timeline tl-newest-first">
    <div class="tl-spheres">
      <h2 class="tl-sphere">Work</h2>
      <h2 class="tl-sphere">Life</h2>
      <TimelineOrder client:load />
      <TimelineFilter client:load tags={allTags} />
    </div>
    <div class="tl-years">
      {
        years.map(([year, yearEvents]) => (
        <section class="tl-year" data-timeline-year>
          <h2 class="tl-year-heading">
            {`${placeByYear.get(year)} - ${year}`}
          </h2>
          <div class="tl-events">
            {yearEvents.map((event) => {
              const Body = bodies.get(event.entry.id);
              return (
                <article
                  class:list={["tl-event", `tl-event--${event.sphere}`]}
                  data-timeline-event
                  data-event-id={event.entry.id}
                  data-tags={event.tags.join(",")}
                >
                  {/* Tag pin on the rail, iconed by the event's first tag.
                      Every event has a location, so every pin is a button —
                      clicking it centers the map on the event's place
                      (wired in TimelineMap). */}
                  <button
                    class:list={[
                      "tl-pin",
                      eventIcon(event) && "tl-pin--glyph",
                    ]}
                    type="button"
                    title={event.tags[0]}
                    aria-label={`Show ${placeLabel(event.location)} on the map`}
                    set:html={pinSvg(48, eventIcon(event), false)}
                  />
                  <p class="tl-month">{monthFmt.format(event.date)}</p>
                  <h3 class="tl-title">
                    <a href={event.url}>{event.title}</a>
                  </h3>
                  <div class="tl-body">
                    {event.summary !== null ? <p>{event.summary}</p> : Body && <Body />}
                  </div>
                </article>
              );
            })}
          </div>
          </section>
        ))
      }
    </div>
  </div>
  {
    showMap && (
      <TimelineMap
        client:load
        apiKey={mapsApiKey}
        mapId={mapsMapId}
        places={places}
      />
    )
  }
</StarlightPage>
