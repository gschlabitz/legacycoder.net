---
import { Image } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import MediaFilter from '../components/MediaFilter.jsx';
import { mediaIcon, mediaStatusIcon } from '../lib/media-icons.js';
import {
  getMediaEntries,
  MEDIA_STATUSES,
  MEDIA_TYPES,
  resolveNote,
} from '../lib/media';

const entries = await getMediaEntries();
---

<StarlightPage
  frontmatter={{
    title: 'Media',
    description: 'A pile of things I am watching, reading, playing, and listening to.',
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <style>
    :global(h1#_top) {
      display: none;
    }
  </style>

  <div class="media-page">
    <header class="media-header">
      <div>
        <p class="media-eyebrow">Books · Movies · Games · Music</p>
        <h1>Media Pile</h1>
        <p>
            Let's be honest; this never has been a queue.
        </p>
      </div>
    </header>

    <MediaFilter
      client:load
      types={[...MEDIA_TYPES]}
      statuses={[...MEDIA_STATUSES]}
    />

    <div class="media-grid">
      {entries.map((entry) => {
        const { data } = entry;
        const note = resolveNote(entry, 'en');
        return (
          <article
            id={entry.id}
            class="media-card"
            data-media-entry
            data-type={data.type}
            data-status={data.status}
            data-recommended={String(data.recommended)}
            data-year={data.year ?? ''}
            data-byline={data.creator ?? ''}
          >
            <a
              class="media-card-target"
              href={data.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Open ${data.title}`}
            ></a>

            <div class="media-art">
              {data.cover ? (
                <Image
                  src={data.cover}
                  alt={`${data.title} cover`}
                  inferSize
                  layout="full-width"
                  loading="lazy"
                />
              ) : (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={mediaIcon(data.type)}
                />
              )}
            </div>

            <div class="media-card-body">
              <h2>{data.title}</h2>

              <div class="media-card-meta">
                {(data.creator || data.year) && (
                  <p class="media-byline">
                    {[data.creator, data.year].filter(Boolean).join(' · ')}
                  </p>
                )}
                <div class="media-chips">
                  {data.recommended && (
                    <span
                      class="media-recommended"
                      aria-label="recommended"
                      data-tooltip="Recommended"
                    >
                      <span aria-hidden="true">♥</span>
                    </span>
                  )}
                  <span
                    class:list={['media-chip', 'media-chip--status', `media-chip--${data.status}`]}
                    aria-label={data.status}
                    data-tooltip={data.status}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={mediaStatusIcon(data.status)}
                    />
                  </span>
                  <span
                    class="media-chip media-chip--type"
                    aria-label={`${data.type} media`}
                    data-tooltip={data.type}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                      set:html={mediaIcon(data.type)}
                    />
                  </span>
                </div>
              </div>

              {data.rating && (
                <p class="media-rating" aria-label={`${data.rating} out of 5 stars`}>
                  <span aria-hidden="true">{'★'.repeat(data.rating)}{'☆'.repeat(5 - data.rating)}</span>
                </p>
              )}

              {note && <p class="media-note">{note}</p>}

              {data.post && (
                <footer class="media-card-footer">
                  <a class="media-post" href={`/${data.post}/`}>Wrote about it →</a>
                </footer>
              )}

            </div>
          </article>
        );
      })}
    </div>

    <p class="media-empty" data-media-empty hidden aria-live="polite">
      Nothing matches those filters.
    </p>
  </div>
</StarlightPage>
