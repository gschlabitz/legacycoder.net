---
import { Image } from 'astro:assets';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import MediaFilter from '../components/MediaFilter.jsx';
import { mediaIcon } from '../lib/media-icons.js';
import {
  getMediaEntries,
  MEDIA_STATUSES,
  MEDIA_TYPES,
  resolveNote,
  sourceLabel,
} from '../lib/media';

const entries = await getMediaEntries();
const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<StarlightPage
  frontmatter={{
    title: 'Media',
    description: 'A pile of things I am watching, reading, playing, and listening to.',
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <style>
    :global(h1#_top) {
      display: none;
    }
  </style>

  <div class="media-page">
    <header class="media-header">
      <div>
        <p class="media-eyebrow">Watch · read · play · listen</p>
        <h1>Media pile</h1>
        <p>
          Not an ordered queue—just what caught my attention, what I am into,
          and what I would recommend.
        </p>
      </div>
      <MediaFilter
        client:load
        types={[...MEDIA_TYPES]}
        statuses={[...MEDIA_STATUSES]}
      />
    </header>

    <div class="media-grid">
      {entries.map((entry) => {
        const { data } = entry;
        const note = resolveNote(entry, 'en');
        return (
          <article
            id={entry.id}
            class="media-card"
            data-media-entry
            data-type={data.type}
            data-status={data.status}
            data-recommended={String(data.recommended)}
          >
            <a
              class="media-art"
              href={data.link}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${data.title} at ${sourceLabel(data.link)}`}
            >
              {data.cover ? (
                <Image
                  src={data.cover}
                  alt={`${data.title} cover`}
                  width={360}
                  height={540}
                  fit="cover"
                  loading="lazy"
                />
              ) : (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={mediaIcon(data.type)}
                />
              )}
            </a>

            <div class="media-card-body">
              <div class="media-chips">
                <span class="media-chip">{data.type}</span>
                <span class:list={['media-chip', `media-chip--${data.status}`]}>
                  {data.status}
                </span>
                {data.recommended && (
                  <span class="media-chip media-chip--recommended">recommended</span>
                )}
              </div>

              <h2>
                <a href={data.link} target="_blank" rel="noopener noreferrer">
                  {data.title}
                </a>
              </h2>

              {(data.creator || data.year) && (
                <p class="media-byline">
                  {[data.creator, data.year].filter(Boolean).join(' · ')}
                </p>
              )}

              {data.rating && (
                <p class="media-rating" aria-label={`${data.rating} out of 5 stars`}>
                  <span aria-hidden="true">{'★'.repeat(data.rating)}{'☆'.repeat(5 - data.rating)}</span>
                </p>
              )}

              {note && <p class="media-note">{note}</p>}

              <footer class="media-card-footer">
                <a
                  class="media-source"
                  href={data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {sourceLabel(data.link)}
                  <span aria-hidden="true">↗</span>
                </a>
                <time datetime={data.added.toISOString()}>
                  Added {dateFormat.format(data.added)}
                </time>
                {data.post && (
                  <a class="media-post" href={`/${data.post}/`}>Wrote about it →</a>
                )}
              </footer>
            </div>
          </article>
        );
      })}
    </div>

    <p class="media-empty" data-media-empty hidden aria-live="polite">
      Nothing matches those filters.
    </p>
  </div>
</StarlightPage>
