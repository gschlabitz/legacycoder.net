---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getMediaEntries } from '../lib/media';

const entries = await getMediaEntries();

// The page is a timeline running downward: queued media above (the future),
// everything currently in progress inside a colored band across the middle
// (the present), finished media below (the past, abandoned entries struck
// through at the tail). One column per media type, all side by side.
// Only these types get a column, in this order; the rest of the registry
// stays in media.yaml but off the page.
const SHOWN_TYPES = ['game', 'show', 'movie', 'book'] as const;

const TYPE_HEADERS: Record<string, { icon: string; label: string }> = {
  game: { icon: '🎮', label: 'Games' },
  show: { icon: '📺', label: 'Shows' },
  movie: { icon: '🎬', label: 'Movies' },
  book: { icon: '📚', label: 'Books' },
};

// getMediaEntries sorts newest-added first; the past keeps finished entries
// ahead of abandoned ones.
const byType = (type: string, statuses: readonly string[]) =>
  entries
    .filter(
      (entry) => entry.data.type === type && statuses.includes(entry.data.status),
    )
    .sort(
      (a, b) => statuses.indexOf(a.data.status) - statuses.indexOf(b.data.status),
    );

const columns = SHOWN_TYPES.map((type) => ({
  type,
  ...TYPE_HEADERS[type],
  future: byType(type, ['queued']),
  now: byType(type, ['consuming']),
  past: byType(type, ['finished', 'abandoned']),
})).filter((column) => column.future.length || column.now.length || column.past.length);
---

<StarlightPage
  frontmatter={{
    title: 'Media',
    description: 'A pile of things I am watching, reading, playing, and listening to.',
    tableOfContents: false,
  }}
  hasSidebar={false}
>
  <style>
    :global(h1#_top) {
      display: none;
    }
  </style>

  <div class="media-page">
    <header class="media-header">
      <div>
        <p class="media-eyebrow">Books · Movies · Games · Music</p>
        <h1>Media Pile</h1>
        <p>
            Let's be honest; this never has been a queue.
        </p>
      </div>
    </header>

    <div class="media-timeline" style={`--media-columns: ${columns.length}`}>
      {columns.map((column, index) => (
        <h2 class="media-type" style={`grid-column: ${index + 2}`}>
          <span aria-hidden="true">{column.icon}</span>
          {column.label}
        </h2>
      ))}

      <div class="media-band" aria-hidden="true"></div>
      <span class="media-label media-label-future">Future</span>
      <span class="media-label media-label-now">Now</span>
      <span class="media-label media-label-past">Past</span>

      {columns.map((column, index) => (
        <>
          <ul class="media-list media-future" style={`grid-column: ${index + 2}`}>
            {column.future.map(({ id, data }) => (
              <li id={id}>
                <a href={data.link} target="_blank" rel="noopener noreferrer">{data.title}</a>
                {data.recommended && (
                  <span class="media-recommended" aria-label="recommended" title="Recommended">♥</span>
                )}
              </li>
            ))}
          </ul>
          <ul class="media-list media-now" style={`grid-column: ${index + 2}`}>
            {column.now.map(({ id, data }) => (
              <li id={id}>
                <a href={data.link} target="_blank" rel="noopener noreferrer">{data.title}</a>
                {data.recommended && (
                  <span class="media-recommended" aria-label="recommended" title="Recommended">♥</span>
                )}
              </li>
            ))}
          </ul>
          <ul class="media-list media-past" style={`grid-column: ${index + 2}`}>
            {column.past.map(({ id, data }) => (
              <li
                id={id}
                class:list={[data.status === 'abandoned' && 'media-abandoned']}
              >
                <a href={data.link} target="_blank" rel="noopener noreferrer">{data.title}</a>
                {data.recommended && (
                  <span class="media-recommended" aria-label="recommended" title="Recommended">♥</span>
                )}
                {data.post && <a class="media-post" href={`/${data.post}/`}>wrote about it →</a>}
              </li>
            ))}
          </ul>
        </>
      ))}
    </div>
  </div>
</StarlightPage>
