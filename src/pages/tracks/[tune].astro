---
// PROTOTYPE — issue #30. A page per tune: its own annotated source, its tempo,
// and a full-size scope. The point is that the background music is not an mp3.
//
// Deliberately non-committal about the open question in #30 (is a tune's
// pattern a typed expression or a string?). This renders today's tune modules
// as text and adds a scope; it introduces no eval, no play-synced highlighting,
// and no new dependency, so it stays valid whichever way that fork is settled.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
// Starlight's Expressive Code `Code`, so the source follows the active skin the
// same way every other code block on the site does. That needs Chameleon's
// `themeCssSelector` callback to reach EC through the root `ec.config.mjs`
// (#33) — without that file this component throws mid-render and truncates the
// page.
import { Code } from "@astrojs/starlight/components";
import config, { tuneLoaders } from "virtual:starlight-pulsar/config";

export async function getStaticPaths() {
  // Prototype-only. The shipping version should get source through
  // `virtual:starlight-pulsar/config`, which already knows every tune's module
  // specifier: this glob sees the built-in directory alone, so a site's custom
  // tune would get a page with an empty source block.
  //
  // Inside the function rather than at module scope: Astro hoists
  // `getStaticPaths` above the frontmatter, so a top-level `const` is still in
  // its temporal dead zone when this runs.
  const sources = import.meta.glob<string>("/packages/starlight-pulsar/tunes/*.ts", {
    query: "?raw",
    import: "default",
    eager: true,
  });

  return Promise.all(
    config.tunes.map(async ({ name, label }) => {
      // Importing a tune module does not build its pattern — `pattern` is a
      // closure called once per playback — so this is safe at build time and
      // gives us the tune's own declared facts rather than a copy of them.
      const { default: tune } = await tuneLoaders[name]!();
      return {
        params: { tune: name },
        props: { name, label, cps: tune.cps, source: sources[`/packages/starlight-pulsar/tunes/${name}.ts`] ?? null },
      };
    }),
  );
}

const { name, label, cps, source } = Astro.props;

// `cps` and seconds per cycle, the same two numbers the Deck's readout carries
// as a tooltip. No BPM: tunes declare no meter (see #29), so a beats-per-minute
// figure would be a guess about how many beats a cycle holds — one bar for
// Grid, one chord for Drift.
const secondsPerCycle = 1 / cps;
---

<StarlightPage
  frontmatter={{
    title: label,
    description: `The Strudel source of ${label}, one of the tunes this site plays.`,
    tableOfContents: false,
    // The page declares its own tune, so a reader on Auto — where every reader
    // starts — hears this tune while reading its source.
    music: name,
  }}
  hasSidebar={false}
>
  <style>
    .track-facts {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin: 0 0 1.5rem;
      padding: 0;
      list-style: none;
      font-family: var(--sl-font-mono);
      font-size: 0.8rem;
      color: var(--sl-color-gray-2);
    }
    .track-fact-label {
      display: block;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      font-size: 0.65rem;
      color: var(--sl-color-gray-3);
    }
    .track-fact-value {
      color: var(--sl-color-white);
    }
    /* The scope canvas takes its trace colour from its own computed `color`,
       so it follows whichever skin Chameleon has active. */
    .track-scope {
      display: block;
      width: 100%;
      height: 96px;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      background: var(--sl-color-black);
      color: var(--sl-color-text-accent);
    }
    .track-scope-note {
      margin: 0.5rem 0 2rem;
      font-size: 0.8rem;
      line-height: 1.5;
      color: var(--sl-color-gray-2);
    }
    .track-source-heading {
      font-size: 1rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--sl-color-gray-3);
      margin: 2rem 0 1rem;
    }
    .track-back {
      display: inline-block;
      margin-top: 2rem;
      font-size: 0.9rem;
    }
  </style>

  <ul class="track-facts">
    <li>
      <span class="track-fact-label">Cycles per second</span>
      <span class="track-fact-value">{cps.toFixed(3)}</span>
    </li>
    <li>
      <span class="track-fact-label">Seconds per cycle</span>
      <span class="track-fact-value">{secondsPerCycle.toFixed(2)}</span>
    </li>
    <li>
      <span class="track-fact-label">Sound sources</span>
      <span class="track-fact-value">Synthesised — no samples</span>
    </li>
  </ul>

  {/* One `data-scope` canvas is all it takes: Pulsar's animation loop queries
      the whole document, so any canvas on the page joins the one existing rAF
      loop. Flat and still until something sounds. */}
  <canvas class="track-scope" data-scope aria-hidden="true"></canvas>
  <p class="track-scope-note">
    Press play in the header to hear it. The trace follows whatever is sounding —
    if you have picked a different tune by hand, your pick still wins here, and
    this will show that one instead.
  </p>

  <h2 class="track-source-heading">Source</h2>
  {
    source ? (
      <Code code={source} lang="ts" title={`packages/starlight-pulsar/tunes/${name}.ts`} />
    ) : (
      <p>No source available for this tune.</p>
    )
  }

  <a class="track-back" href="/tracks">← All tracks</a>
</StarlightPage>
