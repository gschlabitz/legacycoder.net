---
// Title screen of the annual care calendar: the opening section of the
// continuous tile map. Winter ground (January follows seamlessly below),
// a sparse decoration strip, then the centered VT323 title and the intro
// sentences (slot) directly on the snow. Starlight's own page <h1> is
// hidden — it renders outside the map, so this component draws the title
// itself; the frontmatter title still names the tab and sidebar entry.
import '../styles/tiles.css';
import '@fontsource/vt323/latin-400.css';
---

<section class="tile-cal-header">
  <div class="tile-cal-header__strip">
    <span class="ts ts-tiny-ski t-6"></span>
    <span class="ts ts-tiny-ski t-69"></span>
    <span class="ts ts-tiny-ski t-30"></span>
  </div>
  <h1 class="tile-cal-header__title">Patio Gardening</h1>
  <div class="tile-cal-header__intro">
    <slot />
  </div>
</section>

<style is:global>
  /* Starlight's page title renders above the markdown content, outside
     the tile map — hide it; the section below draws its own. */
  h1#_top {
    display: none;
  }
  /* Full-width map: with the splash template (no sidebars) the content
     column's max-width is the last constraint — lift it on this page. */
  .main-pane .sl-container,
  main .sl-container {
    max-width: none;
  }
  /* The title panel holds only the hidden h1 — its padding renders as a
     blank band above the map. Drop it, along with the panel separators
     and vertical padding, so the map meets the site header. */
  .content-panel:has(h1#_top) {
    display: none;
  }
  .content-panel {
    padding-block: 0 !important;
    border-top: none !important;
  }
</style>

<style>
  .tile-cal-header {
    background-color: #edf8fe;
    image-rendering: pixelated;
    /* Tile-multiple height, like every map section (see TileMonth). */
    height: calc(8 * 16 * var(--px));
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-block: 0 !important;
    margin-inline: calc(-1 * var(--sl-content-pad-x, 1rem));
    padding-inline: calc(4 * var(--px));
  }
  .tile-cal-header__strip {
    display: flex;
    justify-content: space-evenly;
    min-height: calc(16 * var(--px));
  }
  .tile-cal-header__title {
    margin: calc(2 * var(--px)) 0 0 !important;
    text-align: center;
    font-family: 'VT323', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    color: #434a5f;
    text-shadow: calc(var(--px) / 2) calc(var(--px) / 2) 0 rgb(255 255 255 / 0.55);
  }
  .tile-cal-header__intro {
    text-align: center;
    font-family: 'VT323', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
  }
  .tile-cal-header__intro :global(p) {
    margin-block: 0.25rem !important;
    font-size: calc(8 * var(--px));
    line-height: 1.3;
    color: #434a5f;
  }
  .tile-cal-header__intro :global(a) {
    color: #1d5b43;
  }
</style>
