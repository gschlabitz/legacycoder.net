---
import Die from "./Die.astro";

// Renders a set of dice on a single line. `faces` is the list of die values;
// optional `groups` splits them into visual clusters (e.g. [2, 2, 2] shows
// three pairs with a gap between each pair) so combos read clearly.
interface Props {
  faces: number[];
  groups?: number[];
}

const { faces, groups } = Astro.props;

const chunks: number[][] = [];
if (groups) {
  let i = 0;
  for (const n of groups) {
    chunks.push(faces.slice(i, i + n));
    i += n;
  }
} else {
  chunks.push(faces);
}
---

<span class="dice-row not-content">
  {
    chunks.map((chunk) => (
      <span class="dice-group">
        {chunk.map((f) => (
          <Die face={f} />
        ))}
      </span>
    ))
  }
</span>

<style>
  .dice-row {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    white-space: nowrap;
  }
  .dice-group {
    display: inline-flex;
    gap: 0.15rem;
  }
</style>
