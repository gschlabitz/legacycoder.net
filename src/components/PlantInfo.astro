---
// Botanical facts card for a potted-plant page, rendered from the page's
// `plant` frontmatter (schema in src/content.config.ts). Labels are
// localized here; the values arrive already in the page's language.
interface Props {
  plant: {
    binomial: string;
    family: string;
    genus: string;
    commonNames?: string[];
    origin?: string;
    light?: string;
    temperature?: string;
  };
}

const { plant } = Astro.props;
const locale = Astro.currentLocale === 'de' ? 'de' : 'en';

const LABELS = {
  en: {
    heading: 'Botanical profile',
    binomial: 'Botanical name',
    family: 'Family',
    genus: 'Genus',
    commonNames: 'Common names',
    origin: 'Origin',
    light: 'Light',
    temperature: 'Temperature',
  },
  de: {
    heading: 'Botanisches Profil',
    binomial: 'Botanischer Name',
    family: 'Familie',
    genus: 'Gattung',
    commonNames: 'Volksnamen',
    origin: 'Herkunft',
    light: 'Licht',
    temperature: 'Temperatur',
  },
}[locale];

const rows: [string, string | undefined, boolean?][] = [
  [LABELS.binomial, plant.binomial, true],
  [LABELS.family, plant.family],
  [LABELS.genus, plant.genus],
  [LABELS.commonNames, plant.commonNames?.join(', ')],
  [LABELS.origin, plant.origin],
  [LABELS.light, plant.light],
  [LABELS.temperature, plant.temperature],
];
---

<dl class="plant-info" aria-label={LABELS.heading}>
  {
    rows.map(([label, value, italic]) =>
      value ? (
        <div>
          <dt>{label}</dt>
          <dd>{italic ? <i>{value}</i> : value}</dd>
        </div>
      ) : null,
    )
  }
</dl>
