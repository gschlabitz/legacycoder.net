---
// Single "reading mode" toggle for the header icon cluster. It collapses BOTH
// Starlight's left nav and right "On this page" outline for a distraction-free
// reading view, persisting the choice in localStorage (key `lc:reading-mode`).
// It removes the `data-has-sidebar` / `data-has-toc` attributes Starlight sets
// on <html>, so the main content reflows wider for free; reading-mode.css hides
// the now-orphaned panels. The no-flash restore lives in astro.config.mjs.
---

<button
  type="button"
  class="reading-mode-toggle print:hidden"
  aria-pressed="false"
  aria-label="Toggle reading mode"
  title="Reading mode"
>
  {/* Closed book — shown when reading mode is off. */}
  <svg class="icon-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
  </svg>
  {/* Open book — shown when reading mode is on. */}
  <svg class="icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
  </svg>
</button>

<script is:inline>
  (function () {
    var KEY = "lc:reading-mode";
    var root = document.documentElement;
    function apply(on) {
      if (on) {
        root.setAttribute("data-reading-mode", "");
        root.removeAttribute("data-has-sidebar");
        root.removeAttribute("data-has-toc");
      } else {
        root.removeAttribute("data-reading-mode");
        root.setAttribute("data-has-sidebar", "");
        root.setAttribute("data-has-toc", "");
      }
    }
    var on = false;
    try { on = localStorage.getItem(KEY) === "1"; } catch (e) {}
    var buttons = document.querySelectorAll(".reading-mode-toggle");
    buttons.forEach(function (btn) {
      // The no-flash head script already applied the saved state; just reflect it.
      btn.setAttribute("aria-pressed", String(on));
      btn.addEventListener("click", function () {
        on = !on;
        apply(on);
        try {
          if (on) localStorage.setItem(KEY, "1");
          else localStorage.removeItem(KEY);
        } catch (e) {}
        buttons.forEach(function (b) {
          b.setAttribute("aria-pressed", String(on));
        });
      });
    });
  })();
</script>
