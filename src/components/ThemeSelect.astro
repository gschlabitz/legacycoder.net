---
// Override Starlight's ThemeSelect to place the reading-mode toggle immediately
// to the left of the appearance (dark/light) toggle, on the appearance side of
// the galaxy theme's header separator. We re-render starlight-theme-galaxy's own
// ThemeSelect (which Starlight would otherwise install) so its custom animated
// toggle is preserved — per the theme's override notice.
import GalaxyThemeSelect from "starlight-theme-galaxy/overrides/ThemeSelect.astro";
import ReadingModeToggle from "./ReadingModeToggle.astro";
---

<ReadingModeToggle />
<GalaxyThemeSelect><slot /></GalaxyThemeSelect>
