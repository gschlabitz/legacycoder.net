---
// Starlight SocialIcons override: the stock icon links, but external
// profiles open in a new tab. mailto: is exempt — target=_blank on an
// email link just leaves an orphaned blank tab behind.
import config from "virtual:starlight/user-config";
import { Icon } from "@astrojs/starlight/components";

const links = config.social || [];
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{
  links.length > 0 && (
    <>
      {links.map(({ label, href, icon }) => (
        <a
          {href}
          title={label}
          rel={isExternal(href) ? "me noopener noreferrer" : "me"}
          target={isExternal(href) ? "_blank" : undefined}
          class="sl-flex"
        >
          <span class="sr-only">{label}</span>
          <Icon name={icon} />
        </a>
      ))}
    </>
  )
}

<style>
  @layer starlight.core {
    a {
      color: var(--sl-color-text-accent);
      padding: 0.5em;
      margin: -0.5em;
    }
    a:hover {
      color: var(--sl-color-white);
    }
  }
</style>
