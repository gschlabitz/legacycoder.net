---
import context from "virtual:starlight/project-context";
import config from "virtual:starlight/user-config";

function stripTrailingSlash(path: string) {
  return path.endsWith("/") ? path.slice(0, -1) : path;
}

function localizedPathname(locale: string): string {
  const url = new URL(Astro.url);
  let targetLocale = locale === "root" ? "" : locale;

  if (!config.locales) return url.pathname;

  const base = stripTrailingSlash(import.meta.env.BASE_URL);
  const hasBase = url.pathname.startsWith(base);

  if (hasBase) url.pathname = url.pathname.replace(base, "");

  const [_leadingSlash, baseSegment] = url.pathname.split("/");
  const htmlExt = ".html";
  const isRootHtml = baseSegment?.endsWith(htmlExt);
  const baseSlug = isRootHtml ? baseSegment?.slice(0, -1 * htmlExt.length) : baseSegment;

  if (baseSlug && baseSlug in config.locales) {
    if (targetLocale) {
      url.pathname = url.pathname.replace(baseSlug, targetLocale);
    } else if (isRootHtml) {
      url.pathname = "/index.html";
    } else {
      url.pathname = url.pathname.replace(`/${baseSlug}`, "");
    }
  } else if (targetLocale) {
    url.pathname = baseSegment === "index.html" ? `/${targetLocale}.html` : `/${targetLocale}${url.pathname}`;
  }

  if (hasBase) url.pathname = `${base}${url.pathname}`;
  if (context.trailingSlash === "never") url.pathname = stripTrailingSlash(url.pathname);

  return url.pathname;
}

const currentLocale = Astro.locals.starlightRoute.locale ?? "root";
const target = currentLocale === "de"
    ? { locale: "root", lang: "en", flag: "🇺🇸", label: "English" }
  : { locale: "de", lang: "de", flag: "🇩🇪", label: "Deutsch" };
const canToggle = config.isMultilingual && config.locales
  && "root" in config.locales && "de" in config.locales;
---

{
  canToggle && (
    <nav class="language-toggle" aria-label={Astro.locals.t("languageSelect.accessibleLabel")}>
      <a
        class="flag-link"
        href={localizedPathname(target.locale)}
        hreflang={target.lang}
        lang={target.lang}
        aria-label={target.label}
        data-tooltip={target.label}
      >
        <span aria-hidden="true">{target.flag}</span>
      </a>
    </nav>
  )
}

<style>
  .language-toggle {
    align-items: center;
    display: flex;
  }

  .flag-link {
    align-items: center;
    border: 1px solid transparent;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    display: inline-flex;
    font-size: 1.125rem;
    height: 2rem;
    justify-content: center;
    line-height: 1;
    position: relative;
    text-decoration: none;
    width: 2rem;
  }

  .flag-link:hover,
  .flag-link:focus-visible {
    background-color: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-5);
  }

  .flag-link:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 2px;
  }
</style>
