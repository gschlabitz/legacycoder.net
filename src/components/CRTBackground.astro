---
/**
 * Pure CSS full-page backdrop animation, of my coding eras:
 * - C on green phosphor
 * - Turbo Pascal on amber
 * - jQuery-era JS
 * - modern TypeScript
 */

/* VT323 for bitmap-style glyphs */
import '@fontsource/vt323/latin-400.css';
---

<div class="crt-bg" data-crt aria-hidden="true">
  <pre class="crt-screen"><span class="crt-text"></span><span
      class="crt-cursor"></span></pre>
  <div class="crt-vignette"></div>
  <div class="crt-tint"></div>
</div>
<button class="crt-pause" type="button" data-crt-pause aria-pressed="false">
  <svg
    class="crt-icon-pause"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
    ><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect
      x="14"
      y="5"
      width="4"
      height="14"
      rx="1"></rect></svg
  >
  <svg
    class="crt-icon-play"
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg
  >
</button>

<style is:global>
  /* backdrop shows through on hero pages only */
  [data-has-hero] .page {
    background: transparent;
  }
  [data-has-hero] header.header {
    background-color: color-mix(in srgb, var(--sl-color-bg) 72%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
</style>

<style>
  .crt-bg {
    --crt-pulse-opacity: 0.04;
    --crt-pulse-blend: screen;
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--sl-color-bg);
  }

  .crt-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: var(--crt-color, #4eff7e);
    opacity: 0;
    mix-blend-mode: var(--crt-pulse-blend);
  }

  .crt-bg.crt-pulse::after {
    /* Pulse the background in time with the bass drum. */
    animation: crt-pulse 555ms linear 55ms;
  }

  .crt-bg.crt-pulse {
    animation: crt-pulse-pop 555ms ease-out 55ms;
  }

  /*
    Simulate an angled view on a CRT screen.
    Negative inset keeps the rotated corners from showing the background.
  */
  .crt-screen {
    position: absolute;
    inset: -4% -30% -20% -2%;
    margin: 0;
    padding: clamp(2rem, 6vh, 4rem) clamp(2rem, 5vw, 5rem);
    font-family: 'VT323', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: clamp(1.6rem, 3.8vw, 3.4rem);
    line-height: 1.3;
    white-space: pre-wrap;
    transform: perspective(1200px) rotateX(7deg) rotateY(14deg) rotateZ(-1deg);
    transform-origin: 12% 20%;
    color: var(--crt-color, #4eff7e);
    text-shadow:
      0 0 4px currentColor,
      0 0 12px color-mix(in srgb, currentColor 60%, transparent);
    opacity: 0.75;
    animation: crt-flicker 4s infinite;
  }

  /* Simulate phosphor mask */
  .crt-text {
    --crt-ink: var(--crt-color, #4eff7e);
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.5) 0 1px,
        transparent 1px 4px
      ),
      repeating-linear-gradient(
        90deg,
        color-mix(in srgb, var(--crt-ink) 70%, #ff2a2a) 0 2px,
        var(--crt-ink) 2px 4px,
        color-mix(in srgb, var(--crt-ink) 70%, #2a55ff) 4px 6px
      );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 0 10px
      color-mix(in srgb, var(--crt-ink) 45%, transparent);
  }
  .crt-cursor {
    background: var(--crt-color, #4eff7e);
  }

  /* On the light theme a glowing phosphor has nothing to glow against —
     darken each era's color into an ink, drop the bloom, and keep only the
     row slicing so the backdrop reads like faint dot-matrix print. */
  :global([data-theme='light']) .crt-screen {
    opacity: 0.5;
  }
  :global([data-theme='light']) .crt-bg {
    --crt-pulse-opacity: 0.06;
    --crt-pulse-blend: multiply;
  }
  :global([data-theme='light']) .crt-text {
    --crt-ink: color-mix(in srgb, var(--crt-color, #4eff7e) 35%, #2e3440);
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.6) 0 1px,
        transparent 1px 4px
      ),
      linear-gradient(var(--crt-ink), var(--crt-ink));
    text-shadow: none;
  }
  :global([data-theme='light']) .crt-cursor {
    background: color-mix(in srgb, var(--crt-color, #4eff7e) 35%, #2e3440);
  }
  .crt-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 0.1em;
    vertical-align: text-bottom;
    background: currentColor;
    animation: crt-blink 1.1s steps(1) infinite;
  }

  .crt-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      transparent 55%,
      rgba(0, 0, 0, 0.35) 100%
    );
  }

  /* Theme wash: a soft radial scrim parked behind the hero (upper middle of
     the viewport) so title, tagline, and actions keep their contrast, over a
     light overall tint that lets the code stay vivid toward the edges. */
  .crt-tint {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 70% 55% at 45% 32%,
        color-mix(in srgb, var(--sl-color-bg) 88%, transparent) 30%,
        transparent 75%
      ),
      color-mix(in srgb, var(--sl-color-bg) 38%, transparent);
  }

  .crt-pause {
    position: fixed;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 10;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 50%;
    background: color-mix(in srgb, var(--sl-color-bg) 75%, transparent);
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  .crt-pause:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
  .crt-pause svg {
    width: 1rem;
    height: 1rem;
  }
  .crt-pause .crt-icon-play,
  .crt-pause[aria-pressed='true'] .crt-icon-pause {
    display: none;
  }
  .crt-pause[aria-pressed='true'] .crt-icon-play {
    display: block;
  }

  @keyframes crt-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes crt-flicker {
    0%,
    100% {
      opacity: 0.75;
    }
    92% {
      opacity: 0.75;
    }
    93% {
      opacity: 0.58;
    }
    94% {
      opacity: 0.75;
    }
    97% {
      opacity: 0.65;
    }
    98% {
      opacity: 0.75;
    }
  }
  @keyframes crt-pulse {
    0% {
      opacity: var(--crt-pulse-opacity);
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes crt-pulse-pop {
    0% {
      transform: scale(1.006);
    }
    100% {
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .crt-bg,
    .crt-screen,
    .crt-cursor,
    .crt-bg::after {
      animation: none;
    }
    .crt-pause {
      display: none;
    }
  }
</style>

<script>
  // Era montage: one snippet per station of the timeline, each with its own
  // phosphor color. Lines stay under ~55 columns so nothing wraps awkwardly
  // behind the hero.
  const SNIPPETS = [
    {
      color: '#4eff7e', // green phosphor
      text: `/* L3 microkernel — Berlin, 1992 */

void ipc_send(thread *dst, msg *m)
{
    if (dst->state == BLOCKED) {
        copy_to(dst->buf, m);
        unblock(dst);
        return;
    }
    enqueue(&dst->queue, m);
}

void sched_yield(void)
{
    thread *next = pick_next(&runq);

    if (next == current)
        return;
    switch_ctx(&current->ctx, &next->ctx);
}`,
    },
    {
      color: '#ffb552', // amber phosphor
      text: `{ TeraCom — 1995 }

procedure DrawStatus(Row: Byte);
var
  I: Integer;
begin
  GotoXY(1, Row);
  TextColor(LightGreen);
  for I := 1 to 78 do Write('=');
  Write('| READY');
end;

procedure PollPort(Port: Word);
begin
  repeat
    Status := ReadByte(Port);
    if Status and RX_READY <> 0 then
      HandleFrame(ReadByte(Port + 1));
  until KeyPressed;
end;`,
    },
    {
      color: '#bfe3ff', // paper-white tube
      text: `// freelance web dev — 2007

$('#gallery a').click(function () {
  var src = $(this).attr('href');
  $('#stage img').fadeOut(200, function () {
    $(this).attr('src', src).fadeIn(200);
  });
  return false;
});

$('#contact form').submit(function () {
  var data = $(this).serialize();
  $.post('/cgi-bin/mail.pl', data, function () {
    $('#status').text('Thanks!').show();
  });
  return false;
});`,
    },
    {
      color: '#d8dee9', // modern LCD
      text: `// GovRecover — 2025

export async function reconcile(claim: Claim) {
  const record = await db.claims.get(claim.id);
  if (!record) throw new NotFound(claim.id);
  return diff(record, claim).apply();
}

export async function notify(owner: Owner) {
  const letter = await render('found-funds', {
    name: owner.name,
    amount: usd(owner.balance),
  });
  await outbox.queue(owner.address, letter);
}`,
    },
  ];

  const root = document.querySelector<HTMLElement>('[data-crt]');
  const textEl = root?.querySelector<HTMLElement>('.crt-text');
  const screenEl = root?.querySelector<HTMLElement>('.crt-screen');
  const pauseBtn = document.querySelector<HTMLButtonElement>(
    '[data-crt-pause]'
  );

  if (root && textEl && screenEl && pauseBtn) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const setLabel = () => {
      const paused = pauseBtn.getAttribute('aria-pressed') === 'true';
      pauseBtn.setAttribute(
        'aria-label',
        paused ? 'Resume background animation' : 'Pause background animation'
      );
    };
    setLabel();

    if (reducedMotion) {
      // Static frame instead of motion: first snippet, fully typed.
      root.style.setProperty('--crt-color', SNIPPETS[0].color);
      textEl.textContent = SNIPPETS[0].text;
    } else {
      let paused = false;
      // Player.astro turns each tune-declared kick step into this event. Restart
      // the phosphor wash so every kick gets a fresh pulse, even mid-fade.
      window.addEventListener('pulsar:pulse', () => {
        if (paused) return;
        root.classList.remove('crt-pulse');
        void root.offsetWidth;
        root.classList.add('crt-pulse');
      });
      root.addEventListener('animationend', (event) => {
        if ((event as AnimationEvent).animationName === 'crt-pulse') root.classList.remove('crt-pulse');
      });
      pauseBtn.addEventListener('click', () => {
        paused = !paused;
        pauseBtn.setAttribute('aria-pressed', String(paused));
        setLabel();
      });

      const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
      const idle = async (ms: number) => {
        await sleep(ms);
        while (paused) await sleep(200);
      };

      // --- typist ----------------------------------------------------------
      // Nobody types code at a constant rate. Letters inside a familiar word
      // come out as one burst from muscle memory; then the hands stall at
      // everything that needs a modifier or a reach into the far corners of
      // the keyboard — braces, brackets, quotes, arrows — and stall longer
      // when the typist has to check what they are closing. So the cadence
      // here is driven by character class instead of a flat interval, over a
      // tempo that drifts from word to word, with the occasional mistyped
      // key noticed a beat too late and backspaced away.
      const rand = (lo: number, hi: number) => lo + Math.random() * (hi - lo);
      const clamp = (n: number, lo: number, hi: number) =>
        Math.min(hi, Math.max(lo, n));

      // Overall pace, as a multiplier on every typing delay below — the
      // figures that follow describe the shape of the cadence, this sets how
      // fast the whole thing runs. (The hold between eras is deliberately
      // outside this, so slowing the typing doesn't stretch the pause.)
      const SPEED = 1.67;
      const beat = (ms: number) => idle(ms * SPEED);

      // Word characters ride the burst; everything else is priced per key.
      // `_` and `$` count as word characters here — they read as part of an
      // identifier (ipc_send, jQuery's $) rather than as punctuation.
      const WORD = /[A-Za-z0-9_$]/;
      // Needs shift or an outer-edge reach on a US layout.
      const SHIFTED = new Set('{}()[]<>|&#@*+~^%"!?:');

      const keyCost = (ch: string) => {
        if ('([{'.includes(ch)) return rand(90, 210);
        // Closers are the worst: the pause is the typist checking the nesting.
        if (')]}'.includes(ch)) return rand(110, 280);
        if (SHIFTED.has(ch)) return rand(70, 180);
        if (ch === ',' || ch === '.' || ch === ';') return rand(55, 130);
        return rand(40, 115);
      };

      // Neighbouring keys, for fumbles that look like fumbles rather than
      // random noise.
      const NEIGHBORS: Record<string, string> = {
        a: 'sqw', b: 'vgn', c: 'xvd', d: 'sfe', e: 'wrd', f: 'dgr',
        g: 'fhtv', h: 'gjy', i: 'uok', j: 'hkn', k: 'jli', l: 'kop',
        m: 'nk', n: 'bmj', o: 'ipl', p: 'ol', q: 'wa', r: 'etf',
        s: 'adw', t: 'ryg', u: 'yij', v: 'cbf', w: 'qes', x: 'zcs',
        y: 'tuh', z: 'xa',
      };
      const fumbleFor = (ch: string) => {
        const near = NEIGHBORS[ch.toLowerCase()];
        if (!near) return ch;
        const hit = near[Math.floor(Math.random() * near.length)];
        return ch === ch.toUpperCase() ? hit.toUpperCase() : hit;
      };

      // The screen buffer is kept alongside the node so a backspace is a
      // slice rather than a read-back of textContent.
      let buf = '';
      const put = (s: string) => {
        buf += s;
        textEl.textContent = buf;
      };
      const rub = () => {
        buf = buf.slice(0, -1);
        textEl.textContent = buf;
      };

      // Comment lines are prose, and prose flows faster than syntax — the
      // `{ ` form catches the Pascal-era comments.
      const isProse = (line: string) => /^\s*(\/\/|\/\*|\*|#|--|\{ )/.test(line);

      // How often a word of four or more characters gets mistyped.
      const FUMBLE_RATE = 0.11;

      const typeWord = async (word: string, tempo: number) => {
        const burst = rand(30, 48) * tempo;
        const fumbleAt =
          word.length >= 4 && Math.random() < FUMBLE_RATE
            ? 1 + Math.floor(Math.random() * (word.length - 2))
            : -1;
        for (let k = 0; k < word.length; k++) {
          const ch = word[k];
          if (k === fumbleAt) {
            put(fumbleFor(ch));
            // Typed on, then caught it.
            await beat(rand(1, 1.6) * burst);
            await beat(rand(120, 340));
            rub();
            await beat(rand(90, 210));
          }
          put(ch);
          // Shift for a capital costs an extra beat (camelCase, CONSTANTS).
          await beat(burst * rand(0.7, 1.35) + (/[A-Z]/.test(ch) ? rand(25, 70) : 0));
        }
      };

      const typeSnippet = async (text: string) => {
        buf = '';
        textEl.textContent = '';
        // Tempo is a delay multiplier: it drifts between words, so some
        // stretches rattle along and others drag.
        let tempo = 1;
        let bias = isProse(text) ? 0.8 : 1;
        let i = 0;

        while (i < text.length) {
          const ch = text[i];

          if (ch === '\n') {
            // Return, then the editor's auto-indent: leading whitespace
            // arrives with the line break instead of being typed out.
            i += 1;
            let indent = '';
            while (text[i] === ' ' || text[i] === '\t') indent += text[i++];
            const rest = text.slice(i, text.indexOf('\n', i) + 1 || undefined);
            put('\n' + indent);
            bias = isProse(indent + rest) ? 0.8 : 1;
            // A blank line is a beat of thinking about the next block.
            await beat(text[i] === '\n' ? rand(400, 950) : rand(190, 520) * tempo);
            continue;
          }

          if (WORD.test(ch)) {
            let word = '';
            while (i < text.length && WORD.test(text[i])) word += text[i++];
            await typeWord(word, tempo * bias);
            tempo = clamp(tempo + rand(-0.3, 0.3), 0.5, 1.8);
            // Now and then the next token needs looking up first.
            if (Math.random() < 0.04) await beat(rand(350, 950));
            continue;
          }

          put(ch);
          await beat(
            (ch === ' ' ? rand(45, 115) : keyCost(ch)) * tempo * bias
          );
          i += 1;
        }
      };

      (async () => {
        for (let i = 0; ; i = (i + 1) % SNIPPETS.length) {
          const { color, text } = SNIPPETS[i];
          root.style.setProperty('--crt-color', color);
          await typeSnippet(text);
          await idle(3200);
          // Power-blink between eras.
          root.style.opacity = '0';
          await sleep(140);
          root.style.opacity = '';
        }
      })();
    }
  }
</script>
